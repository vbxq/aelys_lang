trait Area {
    fn area(&self) -> i64;
    fn tagged(&self) -> i64 { self.area() * 10 + 1 }
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

fn go<T: Area>(x: &T) -> i64 { x.tagged() }

fn main() {
    let a = Sq { s: 3 };
    let b = Rect { w: 2, h: 5 };
    println!("{}", go(&b));
    println!("{}", go(&a));
}
