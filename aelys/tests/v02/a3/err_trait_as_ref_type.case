trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

fn f(x: &Area) -> i64 { 0 }

fn main() {
    println!("{}", f(&Sq { s: 1 }));
}
