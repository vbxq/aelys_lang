trait Unit {
    fn unit() -> Self;
    fn val(&self) -> i64;
}

struct M { v: i64 }
struct N { v: i64 }

impl Unit for M {
    fn unit() -> Self { M { v: 7 } }
    fn val(&self) -> i64 { self.v }
}

impl Unit for N {
    fn unit() -> Self { N { v: 40 } }
    fn val(&self) -> i64 { self.v + 1 }
}

fn main() {
    let m = M::unit();
    let n = N::unit();
    println!("{}", m.val());
    println!("{}", n.val());
}
