trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

trait Name {
    fn name(&self) -> i64;
}

impl Name for Sq {
    fn name(&self) -> i64 { 1 }
}

impl Name for Rect {
    fn name(&self) -> i64 { 2 }
}

fn f<T: Area>(x: T) -> i64 { x.name() }

fn main() {
    println!("{}", f(Sq { s: 1 }));
}
