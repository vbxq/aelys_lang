use std::fmt; struct Nm { name: String, n: i64 }

impl fmt::Display for Nm {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "{}", self.name) }
}

fn len_of<T>(x: T) -> i64 {
    let s = format!("[{x}]");
    s.len()
}

fn bounded<T: fmt::Display>(x: &T) -> i64 {
    let s = x.to_string();
    s.len()
}

fn show<T>(x: T) {
    println!("{}", x);
}

fn main() {
    let mut acc: i64 = 0;
    for i in 0..1000 {
        let t = Nm { name: "abc", n: i };
        acc = acc + len_of(t);
        let u = Nm { name: "abcd", n: i };
        acc = acc + bounded(&u);
    }
    println!("{}", acc);
    for i in 0..3 {
        show(Nm { name: "z", n: i });
    }
}
