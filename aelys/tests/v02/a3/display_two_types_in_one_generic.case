struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Display for Sq {
    fn to_string(&self) -> string { return "sq{self.s}" }
}

impl Display for Rect {
    fn to_string(&self) -> string { return "rect{self.w}x{self.h}" }
}

fn wrap<T: Display>(x: T) -> string { return "<" + x.to_string() + ">" }

fn main() -> i64 {
    println(wrap(Sq { s: 2 }))
    println(wrap(Rect { w: 3, h: 4 }))
    println(wrap(Sq { s: 5 }))
    return 0
}
