trait Tally<T> {
    fn count(&self) -> i64;
}

struct X { v: i64 }

impl Tally<i64> for X {
    fn count(&self) -> i64 { self.v + 1 }
}

impl Tally<String> for X {
    fn count(&self) -> i64 { self.v + 2 }
}

struct Pair<T> { a: T, b: T }

impl<T> Tally<T> for Pair<T> {
    fn count(&self) -> i64 { 2 }
}

fn by_str<S: Tally<String>>(s: &S) -> i64 { s.count() }

fn by_int<S: Tally<i64>>(s: &S) -> i64 { s.count() }

fn main() {
    let x = X { v: 10 };
    println!("{}", by_str(&x));
    println!("{}", by_int(&x));
    let p = Pair { a: "s", b: "t" };
    println!("{}", p.count());
    println!("{}", by_str(&p));
}
