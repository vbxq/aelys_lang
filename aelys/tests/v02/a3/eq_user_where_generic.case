struct K { key: i64, pay: i64 }

impl PartialEq for K {
    fn eq(&self, o: &K) -> bool { self.key == o.key }
}

fn same<T>(a: T, b: T) -> bool where T: PartialEq { a == b }

fn main() {
    println!("{}", same(K { key: 1, pay: 2 }, K { key: 1, pay: 3 }));
    println!("{}", same(K { key: 1, pay: 2 }, K { key: 4, pay: 2 }));
    println!("{}", same(4, 5));
}
