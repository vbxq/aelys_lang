use std::fmt; struct Pair<T> { a: T, b: T }

impl<T: fmt::Display> fmt::Display for Pair<T> {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "({}, {})", self.a, self.b) }
}

fn main() {
    println!("{}", Pair { a: 1, b: 2 });
    println!("{}", Pair { a: "x", b: "y" });
    println!("{}", Pair { a: Pair { a: 1, b: 2 }, b: Pair { a: 3, b: 4 } });
}
