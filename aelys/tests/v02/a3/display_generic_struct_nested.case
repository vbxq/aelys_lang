struct Pair<T> { a: T, b: T }

impl<T: Display> Display for Pair<T> {
    fn to_string(&self) -> string { return "({self.a}, {self.b})" }
}

fn main() -> i64 {
    println(Pair { a: 1, b: 2 })
    println(Pair { a: "x", b: "y" })
    println(Pair { a: Pair { a: 1, b: 2 }, b: Pair { a: 3, b: 4 } })
    return 0
}
