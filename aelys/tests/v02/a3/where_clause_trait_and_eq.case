trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

trait Name {
    fn name(&self) -> i64;
}

impl Name for Sq {
    fn name(&self) -> i64 { 1 }
}

impl Name for Rect {
    fn name(&self) -> i64 { 2 }
}

fn both<T>(x: T) -> i64 where T: Area + Name { x.area() * 10 + x.name() }

fn same<T>(a: T, b: T) -> bool where T: PartialEq { a == b }

fn main() {
    println!("{}", both(Rect { w: 1, h: 3 }));
    println!("{}", both(Sq { s: 4 }));
    println!("{}", same(3, 3));
    println!("{}", same(3, 4));
}
