needs Show from tr
needs ma

struct P { x: i64 }

impl Show for P {
    fn show(&self) -> i64 { return self.x * 1000 }
}

impl eq for P {
    fn eq(&self, o: &P) -> bool { return self.x != o.x }
}

fn helper(x: i64) -> i64 { return x + 100000 }

fn main() -> i64 {
    println(ma.twice(ma.mk(2)))
    println(ma.gen(P { x: 3 }))
    println(ma.gen(ma.mk(3)))
    let r = P { x: 1 }
    println(r.shown())
    println(ma.same(ma.mk(4), ma.mk(4)))
    println(P { x: 4 } == P { x: 4 })
    return 0
}
