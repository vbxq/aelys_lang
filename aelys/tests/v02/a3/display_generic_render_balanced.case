struct P { x: i64 }

impl Display for P {
    fn to_string(&self) -> string { return "p{self.x}" }
}

fn render<T: Display>(x: &T) -> i64 {
    let s = x.to_string()
    return s.len
}

fn main() -> i64 {
    let mut acc: i64 = 0
    for i in 0..1000 {
        let p = P { x: i }
        acc = acc + render(&p)
    }
    println(acc)
    let n: i64 = 5
    println(render(&n))
    return 0
}
