use std::fmt; struct P { x: i64 }

impl fmt::Display for P {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "p{}", self.x) }
}

fn render<T: fmt::Display>(x: &T) -> i64 {
    let s = x.to_string();
    s.len()
}

fn main() {
    let mut acc: i64 = 0;
    for i in 0..1000 {
        let p = P { x: i };
        acc = acc + render(&p);
    }
    println!("{}", acc);
    let n: i64 = 5;
    println!("{}", render(&n));
}
