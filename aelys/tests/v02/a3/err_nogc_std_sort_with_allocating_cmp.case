use std::sort;

struct K { key: i64, pay: i64 }

impl PartialEq for K {
    fn eq(&self, o: &K) -> bool { self.key == o.key }
}

impl Ord for K {
    fn cmp(&self, o: &K) -> i64 {
        let s = format!("{}", self.key);
        s.len() - o.key
    }
}

fn main() {
    let mut arr: [K; 2] = [K { key: 2, pay: 0 }, K { key: 1, pay: 0 }];
    sort::insertion_sort(arr[..]);
    println!("{}", arr[0].key);
}
