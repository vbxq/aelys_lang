needs std.sort

struct K { key: i64, pay: i64 }

impl eq for K {
    fn eq(&self, o: &K) -> bool { return self.key == o.key }
}

impl ord for K {
    fn cmp(&self, o: &K) -> i64 {
        let s = "{self.key}"
        return s.len - o.key
    }
}

fn main() -> i64 {
    let mut arr: [K; 2] = [K { key: 2, pay: 0 }, K { key: 1, pay: 0 }]
    sort.insertion_sort(arr[..])
    println(arr[0].key)
    return 0
}
