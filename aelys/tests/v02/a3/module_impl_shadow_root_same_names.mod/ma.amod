use crate::tr::Show;

pub struct P { pub x: i64 }

impl Show for P {
    fn show(&self) -> i64 { self.x * 10 }
}

impl PartialEq for P {
    fn eq(&self, o: &P) -> bool { self.x == o.x }
}

pub fn mk(v: i64) -> P { P { x: v } }

pub fn twice(p: P) -> i64 { p.show() + p.shown() }

pub fn same(a: P, b: P) -> bool { a == b }

pub fn gen<T: Show>(t: T) -> i64 { t.show() + 1 }
