needs Show from tr

pub struct P { pub x: i64 }

impl Show for P {
    fn show(&self) -> i64 { return self.x * 10 }
}

impl eq for P {
    fn eq(&self, o: &P) -> bool { return self.x == o.x }
}

pub fn mk(v: i64) -> P { return P { x: v } }

pub fn twice(p: P) -> i64 { return p.show() + p.shown() }

pub fn same(a: P, b: P) -> bool { return a == b }

pub fn gen<T: Show>(t: T) -> i64 { return t.show() + 1 }
