struct K { key: i64, pay: i64 }

impl PartialEq for K {
    fn eq(&self, o: &K) -> bool { self.key == o.key }
}

fn same<T: PartialEq>(a: T, b: T) -> bool { a == b }

fn main() {
    let a = (K { key: 1, pay: 10 }, 2);
    let b = (K { key: 1, pay: 99 }, 2);
    let c = (K { key: 2, pay: 10 }, 2);
    println!("{}", a == b);
    println!("{}", a == c);
    println!("{}", a != c);
    println!("{}", same(K { key: 4, pay: 0 }, K { key: 4, pay: 1 }));
}
