struct K { key: i64, pay: i64 }

impl eq for K {
    fn eq(&self, o: &K) -> bool { return self.key == o.key }
}

fn same<T: eq>(a: T, b: T) -> bool { return a == b }

fn main() -> i64 {
    let a = (K { key: 1, pay: 10 }, 2)
    let b = (K { key: 1, pay: 99 }, 2)
    let c = (K { key: 2, pay: 10 }, 2)
    println(a == b)
    println(a == c)
    println(a != c)
    println(same(K { key: 4, pay: 0 }, K { key: 4, pay: 1 }))
    return 0
}
