trait Area {
    fn area(&self) -> i64;
}

fn main() {
    println!("{}", twice(Rect { w: 3, h: 4 }));
    println!("{}", twice(Sq { s: 5 }));
    println!("{}", twice(Rect { w: 1, h: 2 }));
}

fn twice<T: Area>(x: T) -> i64 { x.area() * 2 }

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

struct Rect { w: i64, h: i64 }
struct Sq { s: i64 }
