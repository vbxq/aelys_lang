struct Box1<T> { v: T }

impl<T> Box1<T> {
    fn pass<U>(&self, x: U) -> U { return x }
}

fn main() {
    let mut v: Vec<i64> = vec[11, 22, 33, 44]
    let b = Box1 { v: 5 }
    let r = b.pass(v.as_slice())
    let mut i = 0
    while i < 100 { v.push(i) ; i = i + 1 }
    let w: Vec<i64> = vec[777, 777, 777, 777]
    println(r[0] + r[1])
    println(w[0])
}
