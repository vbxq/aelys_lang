use std::fmt; struct Tag { name: String, n: i64 }

impl fmt::Display for Tag {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "{}#{}", self.name, self.n) }
}

fn main() {
    let mut acc: i64 = 0;
    for i in 0..2000 {
        let t = Tag { name: "t", n: i };
        let s = format!("{t}");
        acc = acc + s.len();
    }
    println!("{}", acc);
    println!("{}", Tag { name: "end", n: 7 });
}
