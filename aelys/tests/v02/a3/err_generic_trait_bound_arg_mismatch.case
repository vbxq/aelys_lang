trait Sink<T> {
    fn put(&mut self, x: T) -> i64;
}

struct Log { total: i64 }

impl Sink<String> for Log {
    fn put(&mut self, x: String) -> i64 { x.len() }
}

fn feed<S: Sink<i64>>(s: &mut S) -> i64 { s.put(3) }

fn main() {
    let mut l = Log { total: 0 };
    println!("{}", feed(&mut l));
}
