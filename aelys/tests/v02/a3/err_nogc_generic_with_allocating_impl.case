trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

nogc fn total<T: Area>(s: &[T]) -> i64 {
    let mut acc: i64 = 0;
    for x in s { acc = acc + x.area(); }
    acc
}

struct Loud { n: i64 }

impl Area for Loud {
    fn area(&self) -> i64 {
        let s = format!("loud{}", self.n);
        s.len()
    }
}

fn main() {
    let a: [Sq; 1] = [Sq { s: 2 }];
    let l: [Loud; 2] = [Loud { n: 1 }, Loud { n: 2 }];
    println!("{}", total(a[..]));
    println!("{}", total(l[..]));
}
