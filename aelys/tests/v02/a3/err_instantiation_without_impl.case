trait Area {
    fn area(&self) -> i64
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { return self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { return self.w * self.h + 1000 }
}

struct Q { x: i64 }

fn ar<T: Area>(x: T) -> i64 { return x.area() }

fn main() -> i64 {
    println(ar(Sq { s: 2 }))
    println(ar(Q { x: 1 }))
    return 0
}
