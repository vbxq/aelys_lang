trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

fn inner<U: Area>(u: U) -> i64 { u.area() + 1 }

fn outer<T: Area>(t: T) -> i64 { inner(t) * 2 }

fn main() {
    println!("{}", outer(Sq { s: 3 }));
    println!("{}", outer(Rect { w: 1, h: 1 }));
    println!("{}", inner(Sq { s: 3 }));
}
