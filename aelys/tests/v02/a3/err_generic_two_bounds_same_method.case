trait A {
    fn name(&self) -> i64;
}

trait B {
    fn name(&self) -> i64;
}

struct P { v: i64 }

impl A for P {
    fn name(&self) -> i64 { self.v + 1 }
}

impl B for P {
    fn name(&self) -> i64 { self.v + 2 }
}

fn f<T: A + B>(x: &T) -> i64 { x.name() }

fn main() {
    let p = P { v: 10 };
    println!("{}", f(&p));
}
