trait Area {
    fn area(&self) -> i64
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { return self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { return self.w * self.h + 1000 }
}

fn main() -> i64 {
    let a = Sq { s: 3 }
    let b = Rect { w: 2, h: 5 }
    println(a.area())
    println(b.area())
    println(Area::area(&a))
    println(Area::area(&b))
    return 0
}
