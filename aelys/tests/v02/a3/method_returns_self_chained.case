trait Grow {
    fn grown(&self) -> Self;
    fn get(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Grow for Sq {
    fn grown(&self) -> Self { Sq { s: self.s + 1 } }
    fn get(&self) -> i64 { self.s * self.s }
}

impl Grow for Rect {
    fn grown(&self) -> Self { Rect { w: self.w * 2, h: self.h } }
    fn get(&self) -> i64 { self.w * self.h + 1000 }
}

fn g2<T: Grow>(x: T) -> i64 { x.grown().grown().get() }

fn main() {
    println!("{}", g2(Sq { s: 1 }));
    println!("{}", g2(Rect { w: 1, h: 5 }));
}
