trait A {
    fn name(&self) -> i64
}

trait B {
    fn name(&self) -> i64
}

struct P { v: i64 }

impl A for P {
    fn name(&self) -> i64 { return self.v + 1 }
}

impl B for P {
    fn name(&self) -> i64 { return self.v + 2 }
}

fn main() -> i64 {
    let p = P { v: 10 }
    println(p.name())
    return 0
}
