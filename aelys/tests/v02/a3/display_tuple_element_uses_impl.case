use std::fmt; struct P { x: i64 }

impl fmt::Display for P {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "P<{}>", self.x) }
}

fn show<T>(t: T) {
    println!("{}", t);
}

fn main() {
    let t = (P { x: 3 }, 7);
    println!("{}", t);
    println!("[{t}]");
    show(P { x: 5 });
}
