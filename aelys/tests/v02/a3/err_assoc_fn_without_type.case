trait Unit {
    fn unit() -> Self
    fn val(&self) -> i64
}

struct M { v: i64 }
struct N { v: i64 }

impl Unit for M {
    fn unit() -> Self { return M { v: 7 } }
    fn val(&self) -> i64 { return self.v }
}

impl Unit for N {
    fn unit() -> Self { return N { v: 40 } }
    fn val(&self) -> i64 { return self.v + 1 }
}

fn main() -> i64 {
    let m: M = Unit::unit()
    println(m.val())
    return 0
}
