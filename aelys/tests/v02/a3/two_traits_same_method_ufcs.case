trait A {
    fn name(&self) -> i64;
}

trait B {
    fn name(&self) -> i64;
}

struct P { v: i64 }

impl A for P {
    fn name(&self) -> i64 { self.v + 1 }
}

impl B for P {
    fn name(&self) -> i64 { self.v + 2 }
}

fn fa<T: A>(x: &T) -> i64 { x.name() }

fn fb<T: B>(x: &T) -> i64 { x.name() }

fn main() {
    let p = P { v: 10 };
    println!("{}", A::name(&p));
    println!("{}", B::name(&p));
    println!("{}", fb(&p));
    println!("{}", fa(&p));
}
