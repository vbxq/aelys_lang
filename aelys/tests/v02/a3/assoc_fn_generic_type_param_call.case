trait Unit {
    fn unit() -> Self;
    fn val(&self) -> i64;
}

struct M { v: i64 }
struct N { v: i64 }

impl Unit for M {
    fn unit() -> Self { M { v: 7 } }
    fn val(&self) -> i64 { self.v }
}

impl Unit for N {
    fn unit() -> Self { N { v: 40 } }
    fn val(&self) -> i64 { self.v + 1 }
}

fn fresh<T: Unit>(x: T) -> i64 {
    let u: T = T::unit();
    u.val() + x.val() * 100
}

fn main() {
    println!("{}", fresh(M { v: 2 }));
    println!("{}", fresh(N { v: 3 }));
}
