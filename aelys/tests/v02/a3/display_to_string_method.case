use std::fmt; struct P { x: i64, y: i64 }

impl fmt::Display for P {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "P({},{})", self.x, self.y) }
}

fn main() {
    let p = P { x: 1, y: 2 };
    let t = p.to_string() + "!";
    println!("{}", t);
    println!("{}", t.len());
    let n: i64 = 5;
    println!("{}", n.to_string() + n.to_string());
}
