struct K { key: i64, pay: i64 }

impl PartialEq for K {
    fn eq(&self, o: &K) -> bool { self.key == o.key }
}

fn main() {
    let a = K { key: 1, pay: 5 };
    let b = K { key: 1, pay: 9 };
    let c = K { key: 2, pay: 5 };
    println!("{}", a == b);
    println!("{}", a == c);
    println!("{}", a != c);
    println!("{}", b != a);
}
