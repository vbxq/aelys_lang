fn victim(n: i64) -> String { "ab" + format!("{n}") }
fn churn() -> Vec<String> {
    let mut keep: Vec<String> = Vec::new();
    let mut i: i64 = 10;
    while i < 50 {
        Vec::push(keep, "Q" + format!("{i}"));
        i = i + 1;
    }
    keep
}
fn take_first<T>(v: &mut Vec<T>, x: T) -> T {
    let old: T = (*v)[0];
    (*v)[0] = x;
    old
}
fn cycle<T>(v: &mut Vec<T>, x: T) -> T {
    let old: T = take_first(v, x);
    Vec::push(*v, old);
    (*v)[0]
}
fn main() {
    let mut v: Vec<String> = Vec::new();
    Vec::push(v, victim(1));
    let r: String = cycle(&mut v, victim(2));
    let k = churn();
    println!("{r} {} {} {}", v[0], v[1], v.len());
}
