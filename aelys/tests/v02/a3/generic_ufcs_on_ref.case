trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

fn g<T: Area>(x: &T) -> i64 { Area::area(x) }

fn main() {
    let a = Sq { s: 4 };
    let b = Rect { w: 2, h: 3 };
    println!("{}", g(&a));
    println!("{}", g(&b));
}
