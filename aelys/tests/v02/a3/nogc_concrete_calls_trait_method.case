trait Area {
    fn area(&self) -> i64;
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Area for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}

impl Area for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}

nogc fn f(s: &Sq) -> i64 { s.area() + 1 }

fn main() {
    let a = Sq { s: 4 };
    println!("{}", f(&a));
}
