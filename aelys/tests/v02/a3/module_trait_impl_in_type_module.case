needs Area from shapes
needs geo

struct Local { v: i64 }

impl Area for Local {
    fn area(&self) -> i64 { return self.v + 1000 }
}

fn ar<T: Area>(x: T) -> i64 { return x.area() }

fn main() -> i64 {
    println(ar(geo.mk(5)))
    println(ar(Local { v: 1 }))
    println(geo.mk(2).area())
    return 0
}
