enum Shape { Sq(i64), Ci(i64) }

impl Display for Shape {
    fn to_string(&self) -> string {
        match *self {
            Shape::Sq(a) => return "sq{a}",
            Shape::Ci(r) => return "ci{r}"
        }
        return ""
    }
}

fn main() -> i64 {
    println(Shape::Sq(3))
    let c = Shape::Ci(7)
    println("={c}=")
    return 0
}
