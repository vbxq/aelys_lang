use std::fmt; enum Shape { Sq(i64), Ci(i64) }

impl fmt::Display for Shape {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match *self {
            Shape::Sq(a) => return write!(f, "sq{a}"),
            Shape::Ci(r) => return write!(f, "ci{r}"),
        }
        write!(f, "")
    }
}

fn main() {
    println!("{}", Shape::Sq(3));
    let c = Shape::Ci(7);
    println!("={c}=");
}
