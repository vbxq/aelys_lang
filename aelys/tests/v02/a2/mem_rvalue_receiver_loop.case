struct N { s: string }

impl N {
    fn tag(&self, i: i64) -> string { return "{self.s}-{i}" }
    fn into_len(self) -> i64 { return self.s.len }
    fn rename(&mut self, i: i64) -> i64 {
        self.s = "n{i}"
        return self.s.len
    }
}

fn mk(i: i64) -> N { return N { s: "x{i}" } }

fn main() {
    let mut t = 0
    for i in 0..1000 {
        t = t + mk(i).tag(i).len + mk(i).into_len() + mk(i).rename(i)
    }
    println(t)
}
