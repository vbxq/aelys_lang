struct N { s: String }

impl N {
    fn tag(&self, i: i64) -> String {
        let s = self.s;
        format!("{s}-{i}")
    }
    fn into_len(self) -> i64 { self.s.len() }
    fn rename(&mut self, i: i64) { self.s = format!("n{i}"); }
}

fn main() {
    let mut n = N { s: "start" };
    for i in 0..500 {
        n.rename(i);
    }
    println!("{}", n.s);
}
