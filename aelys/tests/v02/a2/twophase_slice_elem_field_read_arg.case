struct C { n: i64 }

impl C {
    fn add(&mut self, d: i64) { self.n = self.n + d }
}

fn view(r: &mut Vec<C>) -> &mut [C] { return (*r)[0..2] }

fn main() {
    let mut v: Vec<C> = Vec::new()
    v.push(C { n: 1 })
    v.push(C { n: 40 })
    let w = v
    let s = view(&mut v)
    s[0].add(s[1].n)
    println(v[0].n)
    println(w[0].n)
}
