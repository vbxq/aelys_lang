struct R { w: i64, h: i64 }

impl R {
    fn area(&self) -> i64 { return self.w * self.h }
    fn double_area(&self) -> i64 { return self.area() * 2 }
    fn grow(&mut self, d: i64) { self.w = self.w + d }
    fn grow_twice(&mut self) {
        self.grow(1)
        self.grow(1)
    }
}

fn main() {
    let mut r = R { w: 3, h: 4 }
    println(r.double_area())
    r.grow_twice()
    println(r.area())
}
