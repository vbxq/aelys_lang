struct N { s: String }

impl N {
    fn tag(&self, i: i64) -> String {
        let s = self.s;
        format!("{s}-{i}")
    }
    fn into_len(self) -> i64 { self.s.len() }
    fn rename(&mut self, i: i64) { self.s = format!("n{i}"); }
}

fn main() {
    let mut t = 0;
    for i in 0..1000 {
        let n = N { s: format!("x{i}") };
        t = t + n.into_len();
    }
    println!("{}", t);
}
