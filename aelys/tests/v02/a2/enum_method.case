enum Shape { Sq(i64), Rect(i64, i64) }

impl Shape {
    fn unit() -> Self { return Shape::Sq(1) }
    fn area(&self) -> i64 {
        match *self {
            Shape::Sq(s) => return s * s,
            Shape::Rect(a, b) => return a * b
        }
    }
    fn widen(self, d: i64) -> Self {
        match self {
            Shape::Sq(s) => return Shape::Rect(s + d, s),
            Shape::Rect(a, b) => return Shape::Rect(a + d, b)
        }
    }
}

fn main() {
    let a = Shape::Sq(3)
    let b = Shape::Rect(2, 5)
    println(a.area() + b.area())
    println(a.widen(1).area())
}
