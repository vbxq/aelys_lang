struct Tag { name: string, hits: i64 }

impl Tag {
    fn bump(mut self, s: string) -> Tag {
        self.name = s
        self.hits = self.hits + 1
        return self
    }
}

fn main() {
    let mut total: i64 = 0
    for i in 0..500 {
        let t = Tag { name: "a", hits: i }
        let u = t.bump("bb{i}")
        total = total + u.hits + u.name.len
    }
    println(total)
}
