struct P { x: i64, y: i64 }

impl P {
    fn new(x: i64, y: i64) -> Self { return P { x: x, y: y } }
    fn sum(self) -> i64 { return self.x + self.y }
    fn get(&self) -> i64 { return self.x * 10 + self.y }
    fn bump(&mut self, d: i64) { self.x = self.x + d }
    fn flipped(&self) -> Self { return Self { x: self.y, y: self.x } }
    fn add(self, d: i64) -> Self { return P { x: self.x + d, y: self.y } }
}

struct W { p: P, k: i64 }

fn main() {
    let w = W { p: P { x: 3, y: 4 }, k: 1 }
    println(w.p.get() + w.k)
    println(w.p.sum())
}
