struct P { x: i64, s: String }

impl P {
    fn bump(&mut self, d: i64) {
        self.x = self.x + d;
        self.s = format!("b{d}");
    }
}

fn main() {
    let mut v: Vec<P> = Vec::new();
    v.push(P { x: 1, s: "a" });
    v.push(P { x: 5, s: "c" });
    let w = v;
    for i in 0..100 {
        v[1].bump(i);
    }
    println!("{}", v[1].x);
    println!("{}", w[1].x);
    println!("{}", v[1].s);
    println!("{}", w[1].s);
}
