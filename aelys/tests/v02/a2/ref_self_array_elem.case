struct P { x: i64, y: i64 }

impl P {
    fn new(x: i64, y: i64) -> Self { P { x: x, y: y } }
    fn sum(self) -> i64 { self.x + self.y }
    fn get(&self) -> i64 { self.x * 10 + self.y }
    fn bump(&mut self, d: i64) { self.x = self.x + d; }
    fn flipped(&self) -> Self { Self { x: self.y, y: self.x } }
    fn add(self, d: i64) -> Self { P { x: self.x + d, y: self.y } }
}

fn main() {
    let a = [P { x: 1, y: 1 }, P { x: 2, y: 3 }];
    println!("{}", a[1].get());
    println!("{}", a[0].flipped().add(4).sum());
}
