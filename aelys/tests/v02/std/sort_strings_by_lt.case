use std::slice;
use std::vec;

struct Fiche { name: String, n: i64 }

impl PartialEq for Fiche {
    fn eq(&self, o: &Fiche) -> bool { self.name == o.name }
}

impl Ord for Fiche {
    fn cmp(&self, o: &Fiche) -> i64 {
        if self.name < o.name { return -1; }
        if self.name > o.name { return 1; }
        0
    }
}

fn main() {
    let mut a: [String; 5] = ["pear", "Fig", "apple", "fig", "äb"];
    a.sort();
    println!("{} {} {} {} {}", a[0], a[1], a[2], a[3], a[4]);
    let mut fs: [Fiche; 3] = [Fiche { name: "zoé", n: 1 }, Fiche { name: "ana", n: 2 }, Fiche { name: "lou", n: 3 }];
    fs.sort_unstable();
    println!("{}{}{} {}", fs[0].n, fs[1].n, fs[2].n, fs.max().unwrap_or(Fiche { name: "-", n: 0 }).name);
    let v: Vec<String> = vec!["b", "c", "a"];
    let s = v.sorted();
    println!("{} {} {}", s.join(""), v.join(""), s.binary_search("c"));
}
