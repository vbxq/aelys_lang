use std::fmt; struct P { x: i64, name: String }

impl fmt::Display for P {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "{}={}", self.name, self.x) }
}

fn main() {
    let mut total = 0;
    let mut i = 0;
    while i < 2000 {
        let p = P { x: i % 10, name: "k" };
        let line = format!("[{p:>6}][{i:<5}]");
        total = total + line.len();
        i = i + 1;
    }
    let p = P { x: 3, name: "ab" };
    println!("[{p:>7}][{p:<6}]");
    println!("{}", total);
}
