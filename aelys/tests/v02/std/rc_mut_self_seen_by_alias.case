struct Counter { n: i64 }

impl Counter {
    fn bump(&mut self) { self.n = self.n + 1 }
    fn get(&self) -> i64 { return self.n }
}

fn main() {
    let r: Rc<Counter> = Rc::new(Counter { n: 0 })
    let alias = r
    r.bump()
    r.bump()
    alias.bump()
    println("{r.get()} {alias.get()}")
}
