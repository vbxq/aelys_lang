use std::slice;

fn main() {
    let names: [String; 3] = ["ana", "bo", "cy"];
    println!("{}", names.contains("bo"));
    println!("{}", names.contains("zed"));
    println!("{}", names.index_of("cy"));
    let f = match names.find("ana") {
        Some(i) => i,
        None => -1,
    };
    println!("{}", f);
}
