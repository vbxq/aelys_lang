fn main() {
    let mut out: String = "";
    for i in 1..=15 {
        let w: String = match (i % 3, i % 5) {
            (0, 0) => "FizzBuzz",
            (0, _) => "Fizz",
            (_, 0) => "Buzz",
            _ => format!("{i}"),
        };
        out = out + w + " ";
    }
    println!("{}", out);
}
