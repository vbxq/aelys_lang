static mut trace: i64 = 0;

fn probe(tag: i64, r: bool) -> bool {
    trace = trace * 10 + tag;
    r
}

fn f(o: Option<i64>) -> String {
    match o {
        Some(x) if probe(1, x > 10) => "big",
        Some(x) if probe(2, x > 5) => "mid",
        Some(x) => "small",
        None if probe(3, true) => "none-g",
        None => "none",
    }
}

fn main() {
    let a = f(Some(7));
    println!("{a} {trace}");
    trace = 0;
    let b = f(None);
    println!("{b} {trace}");
}
