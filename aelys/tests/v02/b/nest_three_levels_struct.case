struct Pair { a: i64, b: i64 }

fn f(v: Option<Result<Pair, String>>) -> i64 {
    match v {
        Some(Ok(Pair { a, b: 0 })) => a,
        Some(Ok(Pair { a, b })) => a + b,
        Some(Err(e)) => e.len(),
        None => -1,
    }
}

fn main() {
    println!("{}", f(Some(Ok(Pair { a: 7, b: 0 }))));
    println!("{}", f(Some(Ok(Pair { a: 1, b: 2 }))));
    println!("{}", f(Some(Err("ab" + "cd"))));
    println!("{}", f(None));
}
