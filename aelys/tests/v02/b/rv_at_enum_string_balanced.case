fn pick(o: Option<string>) -> Option<string> {
    return match o { w @ Some(s) if s.len > 1 => w, Some(_) => None, None => Some("d" + "") }
}

fn main() -> i64 {
    let mut keep: Option<string> = None
    let mut n: i64 = 0
    for i in 0..100 {
        let o: Option<string> = Some("x{i}")
        let p = pick(o)
        match p { Some(s) => { n = n + s.len }, None => {} }
        keep = o
    }
    match keep { Some(s) => println(s), None => println("none") }
    println(n)
    return 0
}
