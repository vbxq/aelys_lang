fn advance(o: &mut Option<i64>) -> bool {
    match *o {
        Some(9) => { *o = None },
        Some(x) => { *o = Some(x + 2) },
        None => { return false; }
    }
    true
}

fn main() {
    let mut o: Option<i64> = Some(3);
    let mut n: i64 = 0;
    while advance(&mut o) {
        n = n + 1;
    }
    println!("{}", n);
}
