fn wrap(s: String) -> Option<String> { Some(s + "!") }

fn main() {
    let o: Option<String> = wrap("hi");
    let s: String = match o { Some(v) => v, None => "" };
    println!("{}", s);
    let r: Result<i64, String> = Err("x");
    let n: i64 = match r { Ok(v) => v, Err(_) => -1 };
    println!("{}", n);
    let q: Option<i64> = Some(3);
    match q {
        Some(v) => println!("{}", v),
        _ => println!("{}", 0),
    }
}
