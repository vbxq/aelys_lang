fn h(n: u64) -> string {
    return match n { 0..=9223372036854775807 => "low", 9223372036854775808..=18446744073709551615 => "high" }
}

fn main() -> i64 {
    let a: u64 = 18446744073709551615
    let b: u64 = 9223372036854775808
    let c: u64 = 7
    println(h(a))
    println(h(b))
    println(h(c))
    return 0
}
