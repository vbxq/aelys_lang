enum Tok { Num(i64), Op(char), Word(String), End }

fn f(t: Tok) -> String {
    match t {
        Tok::Num(n @ (1 | 2 | 3)) => format!("small{n}"),
        Tok::Num(n) if n < 0 => "neg",
        Tok::Num(_) => "num",
        Tok::Op('+' | '-') => "additive",
        Tok::Op(c @ '*'..='/') => format!("mul{c}"),
        Tok::Op(_) => "op",
        Tok::Word("let") | Tok::Word("fn") => "kw",
        Tok::Word(w) if w.len() > 3 => "long:" + w,
        Tok::Word(w) => w,
        Tok::End => "end",
    }
}

fn parse(s: String) -> Result<i64, String> {
    if s == "x" { return Err("bad" + ""); }
    Ok(s.len())
}

fn main() {
    println!("{}", f(Tok::Num(2)));
    println!("{}", f(Tok::Num(-4)));
    println!("{}", f(Tok::Num(9)));
    println!("{}", f(Tok::Op('-')));
    println!("{}", f(Tok::Op('/')));
    println!("{}", f(Tok::Op('!')));
    println!("{}", f(Tok::Word("fn")));
    println!("{}", f(Tok::Word("hello" + "")));
    println!("{}", f(Tok::Word("ab")));
    println!("{}", f(Tok::End));
}
