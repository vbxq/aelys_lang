enum V { A(String), B(String), C }

fn mk(i: i64) -> V {
    if i % 3 == 0 { return V::A(format!("a{i}")); }
    if i % 3 == 1 { return V::B(format!("b{i}")); }
    V::C
}

fn main() {
    let mut hit: i64 = 0;
    let mut miss: i64 = 0;
    let mut last: String = "";
    for i in 0..300 {
        match mk(i) {
            V::A(s) | V::B(s) if s.len() > 2 => { hit = hit + 1;
                last = s; },
            V::A(s) | V::B(s) => { miss = miss + s.len(); },
            V::C => {}
        }
    }
    println!("{hit} {miss} {last}");
}
