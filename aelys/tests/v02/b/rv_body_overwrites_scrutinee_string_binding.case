fn take(o: &mut Option<String>) -> String {
    match *o {
        Some(s) => {
            *o = None;
            return s + "!";
        },
        None => { return "none"; }
    }
}

fn main() {
    let mut o: Option<String> = Some("a" + "b");
    println!("{}", take(&mut o));
    println!("{}", take(&mut o));
}
