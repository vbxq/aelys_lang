use std::vec;

fn main() {
    let mut v: Vec<i64> = vec![100, 9, 4, 0, 3, 2, 8];
    let mut t: i64 = 0;
    while let Some(x) = vec::pop(&mut v) {
        if x % 2 == 0 && x != 0 { continue; }
        match x {
            0 => { break; },
            _ => { t = t + x; }
        }
        t = t + 10;
    }
    println!("{}", t);
}
