struct Pair<A, B> { a: A, b: B }

fn label(p: Pair<i64, String>) -> String {
    match p {
        Pair { a: 0, .. } => "zero",
        Pair { a, b } if a > 10 => b + "!",
        Pair { b, .. } => b,
    }
}

fn main() {
    let mut n: i64 = 0;
    for i in 0..60 {
        let s: String = label(Pair { a: i % 15, b: format!("v{i}") });
        n = n + s.len();
    }
    println!("{}", n);
    println!("{}", label(Pair { a: 12, b: "x" + "y" }));
    println!("{}", label(Pair { a: 0, b: "q" }));
}
