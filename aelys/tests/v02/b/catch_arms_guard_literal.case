fn parse(s: string) -> Result<i64, string> {
    if s == "x" { return Err("bad" + "") }
    if s == "y" { return Err("much worse" + "") }
    if s == "z" { return Err("odd") }
    return Ok(s.len)
}

fn get(s: string) -> i64 {
    return parse(s) catch {
        e if e.len > 5 => -1,
        "bad" => -2,
        _ => -3
    }
}

fn main() -> i64 {
    println("{get("x")} {get("y")} {get("z")} {get("abcd")}")
    return 0
}
