struct Node<T> { v: T, next: Rc<Node<T>> }
fn churn(i: i64) -> i64 {
    let a: Rc<Node<i64>> = Rc::new(Node { v: i, next: Rc::null() })
    let b: Rc<Node<i64>> = Rc::new(Node { v: 2, next: a })
    a.next = b
    return Rc::get(Rc::get(a).next).v
}
fn main() {
    let mut i = 0
    let mut n = 0
    while i < 1000 {
        n = n + churn(i)
        i = i + 1
    }
    println(n)
}
