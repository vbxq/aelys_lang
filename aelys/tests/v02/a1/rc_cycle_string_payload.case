struct Node<T> { v: T, next: Rc<Node<T>> }
fn churn(i: i64) -> i64 {
    let a: Rc<Node<String>> = Rc::new(Node { v: "a" + format!("{i}"), next: Rc::null() });
    let b: Rc<Node<String>> = Rc::new(Node { v: "b", next: a });
    a.next = b;
    i % 3
}
fn main() {
    let mut i = 0;
    let mut n = 0;
    while i < 500 {
        n = n + churn(i);
        i = i + 1;
    }
    println!("{}", n);
}
