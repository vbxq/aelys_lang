struct R { screen: Vec<u8>, w: i64 }

nogc fn draw(r: &mut R, x: i64) { r.screen[x] = 7 as u8; }

fn forward(r: &mut R, x: i64) { draw(r, x); }

nogc fn outer(r: &mut R) { forward(r, 1); }

fn main() {
    let mut r = R { screen: vec![1 as u8, 1 as u8, 1 as u8, 1 as u8], w: 0 };
    let keep = r.screen;
    outer(&mut r);
    println!("{} {}", keep[1], r.screen[1]);
}
