struct R { screen: Vec<u8>, w: i64 }

nogc fn draw(r: &mut R, x: i64) {
    r.screen[x] = 7 as u8
}

fn managed_write(r: &mut R) {
    r.screen[1] = 9 as u8
}

fn main() -> i64 {
    let mut r = R { screen: Vec::new(), w: 3 }
    for i in 0..4 { r.screen.push(1 as u8) }
    let snap = r.screen
    r.screen.make_unique()
    draw(&mut r, 2)
    r.screen.make_unique()
    draw(&mut r, 3)
    let snap2 = r.screen
    managed_write(&mut r)
    println("{snap[1]} {snap[2]} {snap[3]} {r.screen[1]} {r.screen[2]} {r.screen[3]} {snap2[1]} {snap2[2]}")
    return 0
}
