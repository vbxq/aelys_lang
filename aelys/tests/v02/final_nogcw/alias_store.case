struct R { screen: Vec<u8>, w: i64 }

nogc fn draw(r: &mut R, x: i64) {
    r.screen[x] = 7 as u8
}

fn main() -> i64 {
    let mut r = R { screen: Vec::new(), w: 3 }
    for i in 0..4 { r.screen.push(1 as u8) }
    draw(&mut r, 0)
    let snap = r.screen
    println("{r.screen[0]} {snap[0]}")
    draw(&mut r, 2)
    println("{snap[2]} {r.screen[2]}")
    return 0
}
