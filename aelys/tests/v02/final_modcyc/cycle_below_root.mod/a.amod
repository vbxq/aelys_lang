needs b
pub enum Shape { Sq(i64), Rect(i64, i64) }
pub fn area(s: Shape) -> i64 {
    return match s {
        Shape::Sq(x) => x * x,
        Shape::Rect(w, h) => w * h
    }
}
pub fn total(n: i64) -> i64 {
    let p: b.Pair<Shape, i64> = b.pair(Shape::Sq(n), n)
    return area(p.first) + b.weight(p)
}
