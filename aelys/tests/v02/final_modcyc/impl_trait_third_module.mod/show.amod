use std::fmt; use crate::shapes::Area;
use crate::geo;
impl Area for geo::Pt {
    fn area(&self) -> i64 { self.v * self.v }
}
impl PartialEq for geo::Pt {
    fn eq(&self, o: &geo::Pt) -> bool { self.v == o.v }
}
impl fmt::Display for geo::Pt {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "Pt({})", self.v) }
}
