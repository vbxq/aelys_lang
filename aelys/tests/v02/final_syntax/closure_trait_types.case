fn apply(f: impl Fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn twice<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(f(x))
}

fn compose<F>(f: F, g: fn(i64) -> i64, x: i64) -> i64 where F: Fn(i64) -> i64 {
    g(f(x))
}

fn main() {
    let k = 3;
    println!("{} {} {}", apply(|x| x + k, 1), twice(|x| x * 2, 5), compose(|x| x - 1, |y| y * y, 4));
}
