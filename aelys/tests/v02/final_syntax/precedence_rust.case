fn low_byte(r: &i64) -> u8 {
    *r as u8
}

fn main() {
    let a = 6;
    let y: i64 = 4;
    println!("{}", a & 3 == 2);
    println!("{}", 1 + 2 << 1);
    println!("{}", a | 1 ^ 3);
    println!("{}", 2 + 3 * 4 % 5);
    let n = 300;
    println!("{}", low_byte(&n));
    if y as i64 < a {
        println!("lt");
    }
}
