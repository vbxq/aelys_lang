trait Shape {
    fn area(&self) -> i64;
}
struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }
impl Shape for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}
impl Shape for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}
fn main() {
    let mut v: Vec<Rc<dyn Shape>> = Vec::new();
    v.push(Rc::new(Sq { s: 3 }));
    v.push(Rc::new(Rect { w: 2, h: 5 }));
    v.push(Rc::new(Sq { s: 4 }));
    let mut total = 0;
    let mut i = 0;
    while i < v.len() {
        println!("{}", v[i].area());
        total = total + v[i].area();
        i = i + 1;
    }
    println!("{}", total);
}
