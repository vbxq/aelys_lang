trait Named {
    fn name(&self) -> String;
    fn greet(&self, who: String) -> String { self.name() + " greets " + who }
}
struct Dog { nick: String, age: i64 }
struct Cat { tag: String }
impl Named for Dog {
    fn name(&self) -> String { "dog " + self.nick }
}
impl Named for Cat {
    fn name(&self) -> String { self.tag }
    fn greet(&self, who: String) -> String { self.tag + " ignores " + who }
}
fn main() {
    let mut zoo: Vec<Rc<dyn Named>> = Vec::new();
    zoo.push(Rc::new(Dog { nick: "rex" + "!", age: 3 }));
    zoo.push(Rc::new(Cat { tag: "tom" }));
    let mut i = 0;
    while i < zoo.len() {
        println!("{}", zoo[i].name());
        println!("{}", zoo[i].greet("ann"));
        i = i + 1;
    }
}
