use crate::a;
use crate::a::Shape;
pub struct Sq { pub s: i64 }
impl Shape for Sq {
    fn area(&self) -> i64 { self.s * self.s }
}
pub struct Rect { pub w: i64, pub h: i64 }
impl Shape for Rect {
    fn area(&self) -> i64 { self.w * self.h + 1000 }
}
pub fn side() -> i64 { 7 }
pub fn boxed(w: i64, h: i64) -> Rc<dyn Shape> { Rc::new(Rect { w: w, h: h }) }
