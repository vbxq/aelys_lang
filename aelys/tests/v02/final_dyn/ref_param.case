trait Shape {
    fn area(&self) -> i64
}
struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }
impl Shape for Sq {
    fn area(&self) -> i64 { return self.s * self.s }
}
impl Shape for Rect {
    fn area(&self) -> i64 { return self.w * self.h + 1000 }
}
fn twice(s: &dyn Shape) -> i64 { return s.area() * 2 }
fn relay(s: &dyn Shape) -> i64 { return twice(s) + 1 }
fn main() -> i64 {
    let a = Sq { s: 5 }
    let b = Rect { w: 3, h: 4 }
    println(twice(&a))
    println(twice(&b))
    println(relay(&a))
    let r: &dyn Shape = &b
    println(r.area())
    return 0
}
