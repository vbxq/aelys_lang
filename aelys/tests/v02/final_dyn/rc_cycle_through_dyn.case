trait Link {
    fn val(&self) -> i64;
}
struct Node { v: i64, next: Rc<dyn Link> }
impl Link for Node {
    fn val(&self) -> i64 { self.v }
}
fn churn(i: i64) -> i64 {
    let a = Rc::new(Node { v: i, next: Rc::null() });
    let b = Rc::new(Node { v: 2, next: a });
    a.next = b;
    a.next.val() + b.next.val()
}
fn main() {
    let mut i = 0;
    let mut n = 0;
    while i < 500 {
        n = n + churn(i);
        i = i + 1;
    }
    println!("{}", n);
}
