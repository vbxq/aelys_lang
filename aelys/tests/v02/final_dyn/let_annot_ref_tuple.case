trait Tr {
    fn v(&self) -> i64
}
struct S { n: i64 }
struct T { n: i64 }
impl Tr for S {
    fn v(&self) -> i64 { return self.n }
}
impl Tr for T {
    fn v(&self) -> i64 { return self.n * 1000 }
}
fn main() -> i64 {
    let t = T { n: 2 }
    let p: (&dyn Tr, i64) = (&t, 5)
    println(p.0.v())
    println(p.1)
    return 0
}
