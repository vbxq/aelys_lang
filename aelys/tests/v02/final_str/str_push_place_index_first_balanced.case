struct W { s: String }

fn idx() -> i64 {
    println("index")
    return 0
}

fn arg() -> String {
    println("arg")
    return "x"
}

fn main() {
    let mut v: Vec<String> = Vec::new()
    v.push("a")
    v[idx()].push_str(arg())
    println(v[0])
    let mut arr: [String; 2] = ["p", "q"]
    arr[idx()].push_str(arg())
    println(arr[0])
    let mut ws: Vec<W> = Vec::new()
    ws.push(W { s: "w" })
    ws[idx()].s.push('c')
    println(ws[0].s)
    let mut i = 0
    v.push("b")
    v[i].push_str({ i = 1; "y" })
    println(v[0])
    println(v[1])
}
