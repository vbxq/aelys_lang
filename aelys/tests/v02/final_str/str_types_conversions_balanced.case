struct Person { name: String, tag: String }

fn shout(s: &str) -> String {
    s + "!"
}

fn own(s: String) -> String {
    s
}

fn first(v: Vec<String>) -> String {
    v[0]
}

fn label() -> String {
    "lbl"
}

fn view(s: &String) -> i64 {
    s.len()
}

fn main() {
    let lit = "abc";
    let owned: String = "def";
    let p = Person { name: "ann", tag: "t1" };
    println!("{}", shout(lit));
    println!("{}", shout(owned));
    println!("{}", shout(p.name));
    println!("{}", own(lit));
    println!("{}", own(owned + lit));
    let mut v: Vec<String> = Vec::new();
    v.push("x");
    v.push(owned);
    println!("{}", first(v));
    println!("{}", v.len());
    println!("{}", label());
    println!("{}", view(&owned));
    let o: Option<String> = Some("opt");
    match o {
        Some(s) => println!("{}", s),
        None => println!("none"),
    }
    let r: &str = owned;
    println!("{}", r);
    let mut acc = "";
    acc = acc + "z";
    println!("{}", acc);
    println!("{}", p.tag);
}
