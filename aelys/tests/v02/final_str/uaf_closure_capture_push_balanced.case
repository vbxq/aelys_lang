fn warm(s: &str) -> String {
    let mut w = String::with_capacity(32);
    w.push_str(s);
    w
}

fn main() {
    let mut cap = warm("cap");
    let g = move || -> String {
        let mut t = cap;
        t.push_str("!");
        t
    };
    let first = g();
    cap.push_str("?");
    println!("{}", first);
    println!("{}", g());
    println!("{}", cap);
}
