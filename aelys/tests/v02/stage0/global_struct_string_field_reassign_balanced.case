struct W<T> { v: T, n: i64 }
static mut g: W<String> = W { v: "init", n: 0 };
fn bump(i: i64) {
    g.v = "g" + format!("{i}");
    g.n = g.n + i;
}
fn main() {
    let mut i = 0;
    while i < 1000 {
        bump(i);
        i = i + 1;
    }
    println!("{}", g.v);
    println!("{}", g.n);
    g.v = "end";
}
