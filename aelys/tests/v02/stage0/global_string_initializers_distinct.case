struct In { s: String, t: String }
struct Out { inner: In, u: String }
static ga: [String; 3] = ["a", "b", "c"];
static g: Out = Out { inner: In { s: "x", t: "y" }, u: "z" };
static h: String = "solo";
fn main() {
    println!("{} {} {}", ga[0], ga[1], ga[2]);
    println!("{} {} {} {h}", g.inner.s, g.inner.t, g.u);
}
