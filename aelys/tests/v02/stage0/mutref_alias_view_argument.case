fn first(v: &mut Vec<i64>) -> &mut [i64] { return (*v)[0..1] }
fn f(a: &mut Vec<i64>, s: &mut [i64]) -> i64 {
    let mut i = 0
    while i < 200000 { Vec::push(*a, i)
      i = i + 1 }
    s[0] = 77
    return s[0]
}
fn m(v: &mut Vec<i64>) -> i64 { return f(v, first(v)) }
fn main() { let mut v: Vec<i64> = vec[1, 2]
 println(m(&mut v))
 println(v[0]) }
