fn mx<T: Ord>(a: T, b: T) -> T {
    if a > b {
        return a;
    }
    b
}

fn smallest<T: Ord>(xs: &[T]) -> T {
    let mut best = xs[0];
    for i in 0..xs.len() {
        if xs[i] < best {
            best = xs[i];
        }
    }
    best
}

fn main() {
    println!("{}", mx("pear", "apple"));
    println!("{}", mx("", "a"));
    let words: [String; 4] = ["pear", "apple", "épi", "apples"];
    println!("{}", smallest(words[0..4]));
    println!("{}", mx(3, 9));
}
