nogc fn before(a: string, b: string) -> bool {
    return a < b
}

nogc fn order(a: string, b: string) -> i64 {
    if a < b {
        return -1
    }
    if a > b {
        return 1
    }
    return 0
}

fn main() {
    println(before("alpha", "beta"))
    println(order("zeta", "zet"))
    println(order("", ""))
    println(order("€", "$"))
}
