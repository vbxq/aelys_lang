use std::str;

fn agree(a: String, b: String) -> bool {
    let c = str::compare(a, b);
    ((a < b) == (c < 0)) && ((a == b) == (c == 0)) && ((a > b) == (c > 0)) && ((a <= b) == (c <= 0)) && ((a >= b) == (c >= 0))
}

fn main() {
    println!("{}", agree("a", "b"));
    println!("{}", agree("b", "a"));
    println!("{}", agree("ab", "abc"));
    println!("{}", agree("", ""));
    println!("{}", agree("", "x"));
    println!("{}", agree("é", "e"));
    println!("{}", agree("日本", "日"));
    println!("{}", agree("same", "same"));
}
