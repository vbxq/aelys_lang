struct In { s: String, t: String }
struct Out { inner: In }
static mut g: Out = Out { inner: In { s: "x", t: "y" } };
fn set(i: i64) {
    g.inner = In { s: "s" + format!("{i}"), t: "t" + format!("{i}") };
}
fn main() {
    let mut i = 0;
    while i < 300 {
        set(i);
        i = i + 1;
    }
    println!("{} {}", g.inner.s, g.inner.t);
    g.inner = In { s: "a", t: "b" };
}
