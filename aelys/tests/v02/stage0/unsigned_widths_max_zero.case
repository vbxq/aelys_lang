fn main() {
    let a: u8 = 255
    let b: u16 = 65535
    let c: u32 = 4294967295
    let d: u64 = 18446744073709551615
    let a0: u8 = 0
    let b0: u16 = 0
    let c0: u32 = 0
    let d0: u64 = 0
    println("{a} {b} {c} {d}")
    println("{a0} {b0} {c0} {d0}")
    println(a)
    println(b)
    println(c)
    println(d)
    println(d0)
}
