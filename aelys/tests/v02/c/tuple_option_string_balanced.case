fn find(i: i64) -> Option<(String, i64)> {
    if i % 2 == 0 { return Some((format!("e{i}"), i)); }
    None
}
fn main() {
    let mut n = 0;
    for i in 0..100 {
        n = match find(i) {
            Some(p) => n + p.0.len() + p.1,
            None => n + 1,
        };
    }
    println!("{}", n);
}
