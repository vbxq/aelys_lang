enum Expr { Num(i64), Neg(Rc<Expr>), Bin(char, Rc<Expr>, Rc<Expr>) }

fn main() {
    let e = Expr::Neg(Rc::new(Expr::Num(2)));
    let f = move || -> i64 {
        match e {
            Expr::Num(n) => { return n; }
            Expr::Neg(x) => { return 1; }
            Expr::Bin(o, l, r) => { return 2; }
        }
        3
    };
    println!("{}", f());
}
