fn show(o: Option<i64>) {
    match o {
        Some(x) => { println!("{}", x); }
        None => { println!("none"); }
    }
}

fn main() {
    let mut v: Vec<i64> = Vec::new();
    show(Vec::pop(v));
    println!("{}", v.len());
    Vec::push(v, 5);
    show(Vec::pop(v));
    show(Vec::pop(v));
}
