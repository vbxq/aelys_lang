fn mk(i: i64) -> String { format!("s{i}") }
fn main() {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < 1000 {
        let mut v: Vec<String> = Vec::new();
        Vec::push(v, mk(i));
        Vec::push(v, mk(i + 1));
        Vec::push(v, mk(i + 2));
        Vec::remove(v, 0);
        Vec::pop(v);
        n = n + v.len() + v[0].len();
        i = i + 1;
    }
    println!("{}", n);
}
