fn mk(i: i64) -> String { format!("s{i}") }
fn maker(i: i64) -> fn() -> i64 {
    let v: Vec<String> = vec![mk(i), mk(i + 1)];
    let s = mk(i);
    let f = move || -> i64 { v.len() + s.len() };
    f
}
fn main() {
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < 500 {
        let mut w: Vec<i64> = vec![i];
        let g = move || -> i64 { w[0] + w.len() };
        Vec::push(w, 3);
        let f = maker(i);
        let h = f;
        t = t + g() + f() + h() + w.len();
        i = i + 1;
    }
    println!("{}", t);
}
