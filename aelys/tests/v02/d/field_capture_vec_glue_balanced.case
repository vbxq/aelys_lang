fn mk(i: i64) -> string { return "s{i}" }
fn maker(i: i64) -> fn() -> i64 {
    let v: Vec<string> = vec[mk(i), mk(i + 1)]
    let s = mk(i)
    let f = fn() -> i64 { return v.len + s.len }
    return f
}
fn main() -> i64 {
    let mut t: i64 = 0
    let mut i: i64 = 0
    while i < 500 {
        let mut w: Vec<i64> = vec[i]
        let g = fn() -> i64 { return w[0] + w.len }
        Vec::push(w, 3)
        let f = maker(i)
        let h = f
        t = t + g() + f() + h() + w.len
        i = i + 1
    }
    println(t)
    return 0
}
