fn mk(i: i64) -> String { format!("s{i}") }
struct Tags { items: Vec<String> }

fn main() {
    let mut b = Tags { items: vec![mk(0)] };
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < 1000 {
        b.items = vec![mk(i), mk(i + 1)];
        t = t + b.items.len();
        i = i + 1;
    }
    println!("{}", t);
    println!("{}", b.items[1]);
}
