fn mk(i: i64) -> String { format!("s{i}") }

fn main() {
    let mut v: Vec<String> = vec![mk(1), mk(2)];
    let g = Vec::get(v, 0);
    Vec::pop(v);
    Vec::clear(v);
    match g {
        Some(s) => { println!("{}", s); }
        None => { println!("none"); }
    }
    println!("{}", v.len());
}
