fn mk(n: i64) -> Vec<i64> {
    let mut d: Vec<i64> = Vec::new()
    let mut i: i64 = 0
    while i < n { Vec::push(d, i * 10)
        i = i + 1 }
    return d
}

fn bump(p: (Vec<i64>, i64)) -> i64 {
    let mut q = p
    Vec::push(q.0, 9)
    Vec::push(q.0, 9)
    return q.0.len + q.1
}
fn main() -> i64 {
    let mut t: i64 = 0
    let mut i: i64 = 0
    while i < 100 {
        let p: (Vec<i64>, i64) = (mk(2), i)
        t = t + bump(p) * 10 + p.0.len
        i = i + 1
    }
    println(t)
    return 0
}
