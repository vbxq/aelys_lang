fn mk(i: i64) -> String { format!("s{i}") }
struct Tags { items: Vec<String> }

fn main() {
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 1000 {
        let mut t = Tags { items: vec![mk(i)] };
        let c = t;
        Vec::push(t.items, mk(i + 1));
        acc = acc + c.items.len() * 10 + t.items.len();
        i = i + 1;
    }
    println!("{}", acc);
}
