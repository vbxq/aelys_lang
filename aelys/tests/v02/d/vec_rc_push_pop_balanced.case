struct Node { val: i64 }
fn main() -> i64 {
    let mut v: Vec<Rc<Node>> = Vec::new()
    let mut t: i64 = 0
    let mut i: i64 = 0
    while i < 1000 {
        Vec::push(v, Rc::new(Node { val: i }))
        Vec::push(v, Rc::new(Node { val: 1 }))
        match Vec::pop(v) {
            Some(n) => { t = t + Rc::get(n).val }
            None => { t = t - 1000000 }
        }
        i = i + 1
    }
    println(t)
    println(v.len)
    println(Rc::get(v[999]).val)
    return 0
}
