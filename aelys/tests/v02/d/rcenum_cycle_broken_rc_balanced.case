struct Node { val: i64, next: Link }
enum Link { Nil, Cons(Rc<Node>) }
fn follow(a: Rc<Node>) -> i64 {
    let mut r: i64 = 0
    match Rc::get(a).next {
        Link::Cons(n) => { r = Rc::get(n).val }
        Link::Nil => { r = -1 }
    }
    return r
}
fn churn(i: i64) -> i64 {
    let a: Rc<Node> = Rc::new(Node { val: i, next: Link::Nil })
    let b: Rc<Node> = Rc::new(Node { val: 2, next: Link::Cons(a) })
    a.next = Link::Cons(b)
    let r: i64 = Rc::get(a).val + follow(a)
    a.next = Link::Nil
    return r
}
fn main() -> i64 {
    let mut t: i64 = 0
    let mut i: i64 = 0
    while i < 1000 {
        t = t + churn(i)
        i = i + 1
    }
    println(t)
    return 0
}
