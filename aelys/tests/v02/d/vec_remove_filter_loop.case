fn main() {
    let mut v: Vec<i64> = Vec::new();
    for k in 1..11 { Vec::push(v, k); }
    let mut i: i64 = 0;
    while i < v.len() {
        if v[i] % 2 == 0 {
            Vec::remove(v, i);
        } else {
            i = i + 1;
        }
    }
    let mut s: i64 = 0;
    for j in 0..v.len() { s = s + v[j]; }
    println!("{}", s);
    println!("{}", v.len());
}
