struct N { val: i64 }
fn id<T>(x: T) -> T { x }
fn twice<T>(x: T) -> T {
    let a = x;
    let b = a;
    b
}
fn keep<T>(v: &mut T, x: T) { *v = x; }
fn val(o: Option<Rc<N>>) -> i64 {
    let mut r: i64 = 0;
    match o {
        Some(n) => { r = Rc::get(n).val; }
        None => { r = -1; }
    }
    r
}
fn main() {
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < 300 {
        let o: Option<Rc<N>> = Some(Rc::new(N { val: i }));
        let p = id(o);
        let q = twice(Some(Rc::new(N { val: 2 })));
        t = t + val(p) + val(q) + val(id(None));
        i = i + 1;
    }
    println!("{}", t);
}
