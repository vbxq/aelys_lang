struct Cell { k: i64, t: T }
enum T { Num(i64), One(Rc<Cell>) }
fn mk(k: i64) -> Rc<Cell> {
    __aelys_collect()
    return Rc::new(Cell { k: k, t: T::Num(5) })
}
fn probe(i: i64) -> i64 {
    let x: Rc<Cell> = Rc::new(Cell { k: i, t: T::Num(123456789) })
    if i >= 0 {
        let y: Rc<Cell> = x
    }
    x.t = T::One(mk(i))
    x.t = T::One(mk(i + 1))
    x.t = T::Num(987654321)
    __aelys_collect()
    return Rc::get(x).k
}
fn main() -> i64 {
    let mut t: i64 = 0
    let mut i: i64 = 0
    while i < 1000 {
        t = t + probe(i)
        i = i + 1
    }
    println(t)
    return 0
}
