fn mk(n: i64) -> Vec<i64> {
    let mut d: Vec<i64> = Vec::new()
    let mut i: i64 = 0
    while i < n { Vec::push(d, i)
        i = i + 1 }
    return d
}

fn classify(o: Option<Vec<i64>>) -> i64 {
    match o {
        Some(v) if v.len > 3 => { return 100 + v.len }
        Some(v) if v.len > 1 => { return 10 + v.len }
        Some(v) => { return v.len }
        None => { return -1 }
    }
    return 0
}
fn main() -> i64 {
    let mut t: i64 = 0
    let mut i: i64 = 0
    while i < 300 {
        let o = if i % 7 == 0 { None } else { Some(mk(i % 6)) }
        t = t + classify(o)
        i = i + 1
    }
    println(t)
    return 0
}
