struct Pair { name: String, k: i64 }
fn s(i: i64) -> String { format!("s{i}") }
fn g(i: i64) -> Option<i64> {
    if i % 2 == 0 { return None; }
    Some(i)
}
fn build(i: i64) -> Option<i64> {
    let p = Pair { name: s(i), k: g(i)? };
    Some(p.name.len() + p.k)
}
fn main() {
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < 300 {
        match build(i) { Some(x) => { t = t + x; } None => { t = t + 100; } }
        i = i + 1;
    }
    println!("{}", t);
}
