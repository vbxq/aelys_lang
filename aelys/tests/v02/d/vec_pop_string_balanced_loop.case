fn mk(i: i64) -> String { format!("s{i}") }

fn main() {
    let mut total: i64 = 0;
    let mut last: String = "";
    let mut i: i64 = 0;
    while i < 1000 {
        let mut v: Vec<String> = Vec::new();
        Vec::push(v, mk(i));
        Vec::push(v, mk(i + 1));
        Vec::push(v, mk(i + 2));
        let mut go: bool = true;
        while go {
            match Vec::pop(v) {
                Some(s) => { total = total + 1;
                    last = s; }
                None => { go = false; }
            }
        }
        i = i + 1;
    }
    println!("{}", total);
    println!("{}", last);
}
