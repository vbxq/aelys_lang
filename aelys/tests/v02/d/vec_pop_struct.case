fn mk(i: i64) -> String { format!("s{i}") }
struct P { name: String, n: i64 }

fn main() {
    let mut v: Vec<P> = Vec::new();
    Vec::push(v, P { name: mk(1), n: 10 });
    Vec::push(v, P { name: mk(2), n: 20 });
    match Vec::pop(v) {
        Some(p) => { println!("{} {}", p.name, p.n); }
        None => { println!("none"); }
    }
    println!("{}", v.len());
    println!("{}", v[0].name);
}
