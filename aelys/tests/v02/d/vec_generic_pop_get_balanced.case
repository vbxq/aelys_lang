fn mk(i: i64) -> String { format!("s{i}") }
fn take<T>(v: &mut Vec<T>) -> Option<T> { Vec::pop(*v) }
fn peek<T>(v: &Vec<T>, i: i64) -> Option<T> { Vec::get(*v, i) }
fn mkv(n: i64) -> Vec<String> {
    let mut v: Vec<String> = Vec::new();
    for k in 0..n { Vec::push(v, mk(k)); }
    v
}
fn main() {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < 300 {
        let mut v: Vec<String> = mkv(3);
        match take(&mut v) { Some(s) => { total = total + s.len(); } None => { total = total - 1000; } }
        match peek(&v, 1) { Some(s) => { total = total + s.len() * 10; } None => { total = total - 1000; } }
        match peek(&v, 7) { Some(s) => { total = total - 1000; } None => { total = total + 100; } }
        match Vec::get(mkv(2), 1) { Some(s) => { total = total + s.len() * 1000; } None => { total = total - 1000; } }
        let o = Vec::pop(v);
        let p = o;
        match p { Some(s) => { total = total + s.len() * 10000; } None => { total = total - 1; } }
        Vec::get(v, 0);
        Vec::pop(v);
        Vec::pop(v);
        total = total + v.len();
        i = i + 1;
    }
    println!("{}", total);
}
