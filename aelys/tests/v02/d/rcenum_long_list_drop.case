struct Node { val: i64, next: Link }
enum Link { Nil, Cons(Rc<Node>) }
fn build(n: i64) -> Link {
    let mut head: Link = Link::Nil;
    let mut i: i64 = 1;
    while i <= n {
        head = Link::Cons(Rc::new(Node { val: i, next: head }));
        i = i + 1;
    }
    head
}
fn sum(l: Link) -> i64 {
    let mut cur: Link = l;
    let mut s: i64 = 0;
    let mut go: bool = true;
    while go {
        match cur {
            Link::Cons(n) => { s = s + Rc::get(n).val;
                cur = Rc::get(n).next; }
            Link::Nil => { go = false; }
        }
    }
    s
}

fn main() {
    println!("{}", sum(build(100000)));
}
