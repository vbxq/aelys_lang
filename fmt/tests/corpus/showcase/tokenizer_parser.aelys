enum Tok {
    Num(i64),
    Op(char),
    Paren(char),
    End,
}

impl Display for Tok {
    fn to_string(&self) -> String {
        match self {
            Tok::Num(n) => n.to_string(),
            Tok::Op(c) | Tok::Paren(c) => format!("'{c}'"),
            Tok::End => "end of input".to_string(),
        }
    }
}

enum Expr {
    Num(i64),
    Neg(Rc<Expr>),
    Bin(char, Rc<Expr>, Rc<Expr>),
}

impl Display for Expr {
    fn to_string(&self) -> String {
        match self {
            Expr::Num(n) => n.to_string(),
            Expr::Neg(x) => format!("(neg {x})"),
            Expr::Bin(op, l, r) => format!("({op} {l} {r})"),
        }
    }
}

fn tokenize(src: &str) -> Result<Vec<Tok>, String> {
    let mut toks = Vec::new();
    let mut num: Option<i64> = None;
    for c in format!("{src} ").chars() {
        if let '0'..='9' = c {
            let d = c as i64 - '0' as i64;
            num = Some(num.unwrap_or(0) * 10 + d);
            continue;
        }
        if let Some(n) = num {
            toks.push(Tok::Num(n));
            num = None;
        }
        match c {
            ' ' => {}
            '+' | '-' | '*' | '/' => toks.push(Tok::Op(c)),
            '(' | ')' => toks.push(Tok::Paren(c)),
            other => return Err(format!("unexpected character '{other}'")),
        }
    }
    toks.push(Tok::End);
    Ok(toks)
}

struct Parser {
    toks: Vec<Tok>,
    pos: i64,
}

impl Parser {
    fn new(toks: Vec<Tok>) -> Self {
        Parser { toks, pos: 0 }
    }

    fn peek(&self) -> Tok {
        self.toks[self.pos]
    }

    fn bump(&mut self) -> Tok {
        self.pos += 1;
        self.toks[self.pos - 1]
    }

    fn eat_op(&mut self, ops: &str) -> Option<char> {
        if let Tok::Op(c) = self.peek() {
            if ops.contains(c) {
                self.pos += 1;
                return Some(c);
            }
        }
        None
    }

    fn binary(&mut self, level: i64) -> Result<Rc<Expr>, String> {
        if level == 2 {
            return self.unary();
        }
        let ops = if level == 0 { "+-" } else { "*/" };
        let mut lhs = self.binary(level + 1)?;
        while let Some(op) = self.eat_op(ops) {
            lhs = Rc::new(Expr::Bin(op, lhs, self.binary(level + 1)?));
        }
        Ok(lhs)
    }

    fn unary(&mut self) -> Result<Rc<Expr>, String> {
        if self.eat_op("-").is_some() {
            return Ok(Rc::new(Expr::Neg(self.unary()?)));
        }
        let at = self.pos;
        match self.bump() {
            Tok::Num(n) => Ok(Rc::new(Expr::Num(n))),
            Tok::Paren('(') => {
                let inner = self.binary(0)?;
                self.close(at, inner)
            }
            t => Err(format!("unexpected {t} at token {at}")),
        }
    }

    fn close(&mut self, open: i64, inner: Rc<Expr>) -> Result<Rc<Expr>, String> {
        match self.bump() {
            Tok::Paren(')') => Ok(inner),
            t => Err(format!("missing ')' for the '(' at token {open}, found {t}")),
        }
    }
}

fn parse(src: &str) -> Result<Rc<Expr>, String> {
    let mut p = Parser::new(tokenize(src)?);
    let tree = p.binary(0)?;
    match p.peek() {
        Tok::End => Ok(tree),
        t => Err(format!("unexpected {t} at token {}", p.pos)),
    }
}

fn apply(op: char, a: i64, b: i64) -> Result<i64, String> {
    match (op, b) {
        ('+', _) => Ok(a + b),
        ('-', _) => Ok(a - b),
        ('*', _) => Ok(a * b),
        ('/', 0) => Err("division by zero".to_string()),
        ('/', -1) if a == i64::MIN => Err(format!("overflow in {a} / -1")),
        ('/', d) => Ok(a / d),
        (other, _) => Err(format!("unknown operator '{other}'")),
    }
}

fn eval(e: &Expr) -> Result<i64, String> {
    match e {
        Expr::Num(n) => Ok(n),
        Expr::Neg(x) => Ok(-eval(x)?),
        Expr::Bin(op, l, r) => apply(op, eval(l)?, eval(r)?),
    }
}

fn run(src: &str) {
    match parse(src) {
        Err(e) => println!("{src}  =>  syntax error: {e}"),
        Ok(tree) => match eval(&tree) {
            Ok(v) => println!("{src}  =>  {tree} = {v}"),
            Err(e) => println!("{src}  =>  {tree}: {e}"),
        },
    }
}

fn main() {
    let sources = [
        "1 + 2 * 3",
        "(1 + 2) * 3",
        "10 / 3 - -4",
        "-(8 - 10) * 7",
        "100 / (7 - 2 * 3) / 4",
        "-7 / 2",
        "4 / (2 - 2)",
        "(0 - 9223372036854775807 - 1) / -1",
        "(1 + 2",
        "3 + * 4",
        "1 2",
        "2 $ 3",
    ];
    for src in sources {
        run(src);
    }
}
