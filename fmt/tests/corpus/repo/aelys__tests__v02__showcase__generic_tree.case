use std::fmt; use std::str;

struct Node<T> { val: T, left: Option<Rc<Node<T>>>, right: Option<Rc<Node<T>>> }

struct Tree<T> { root: Option<Rc<Node<T>>>, count: i64 }

trait Collection<T> {
    fn insert(&mut self, x: T) -> bool;
    fn contains(&self, x: T) -> bool;
    fn len(&self) -> i64;
    fn is_empty(&self) -> bool { self.len() == 0 }
}

impl<T: Ord> Tree<T> {
    fn new() -> Self { Tree { root: None, count: 0 } }
    fn min(&self) -> Option<T> {
        let mut cur = self.root;
        let mut best: Option<T> = None;
        while let Some(n) = cur {
            best = Some(Rc::get(n).val);
            cur = Rc::get(n).left;
        }
        best
    }
    fn in_order(&self) -> Vec<T> {
        let mut out: Vec<T> = Vec::new();
        walk(self.root, &mut out);
        out
    }
}

impl<T: Ord> Collection<T> for Tree<T> {
    fn insert(&mut self, x: T) -> bool {
        if let Some(n) = self.root {
            if !insert_at(n, x) { return false; }
        } else {
            self.root = Some(leaf(x));
        }
        self.count = self.count + 1;
        true
    }
    fn contains(&self, x: T) -> bool {
        let mut cur = self.root;
        while let Some(n) = cur {
            let node = Rc::get(n);
            if x == node.val { return true; }
            cur = if x < node.val { node.left } else { node.right };
        }
        false
    }
    fn len(&self) -> i64 { self.count }
}

fn leaf<T>(x: T) -> Rc<Node<T>> { Rc::new(Node { val: x, left: None, right: None }) }

fn insert_at<T: Ord>(n: Rc<Node<T>>, x: T) -> bool {
    let node = Rc::get(n);
    if x == node.val { return false; }
    let next = if x < node.val { node.left } else { node.right };
    if let Some(child) = next { return insert_at(child, x); }
    if x < node.val { n.left = Some(leaf(x)); } else { n.right = Some(leaf(x)); }
    true
}

fn walk<T>(link: Option<Rc<Node<T>>>, out: &mut Vec<T>) {
    if let Some(n) = link {
        let node = Rc::get(n);
        walk(node.left, out);
        out.push(node.val);
        walk(node.right, out);
    }
}

fn height<T>(link: Option<Rc<Node<T>>>) -> i64 {
    if let Some(n) = link {
        let (l, r) = (height(Rc::get(n).left), height(Rc::get(n).right));
        return if l > r { l + 1 } else { r + 1 };
    }
    0
}

struct Word { text: String }

impl PartialEq for Word { fn eq(&self, o: &Word) -> bool { self.text == o.text } }
impl Ord for Word { fn cmp(&self, o: &Word) -> i64 { str::compare(self.text, o.text) } }
impl fmt::Display for Word { fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "{}", self.text) } }

fn render<T: fmt::Display>(items: Vec<T>) -> String {
    let mut out = "";
    for x in items.as_slice() {
        out = if out.len() == 0 { format!("{x}") } else { format!("{out} {x}") };
    }
    out
}

fn report<T, C: Collection<T>>(name: String, c: &C, sample: &[T]) {
    println!("{name}: {} items, empty={}", c.len(), c.is_empty());
}

fn fill<T, C: Collection<T>>(c: &mut C, xs: &[T]) -> i64 {
    let mut dups: i64 = 0;
    for x in xs {
        if !c.insert(x) { dups = dups + 1; }
    }
    dups
}

fn summarize<T>(name: String, t: &Tree<T>, dups: i64, probe: T, absent: T) where T: Ord + fmt::Display {
    println!("{name}: {} items, empty={}", t.len(), t.is_empty());
    println!("duplicates: {dups}");
    println!("in order: {}", render(t.in_order()));
    println!("contains {probe}: {}, contains {absent}: {}", t.contains(probe), t.contains(absent));
    if let Some(m) = t.min() {
        println!("min: {m}, height: {}", height(t.root));
    }
}

fn main() {
    let mut nums: Tree<i64> = Tree::new();
    let none: [i64; 1] = [0];
    report("nums", &nums, none[0..0]);
    let xs: [i64; 10] = [50, 30, 70, 20, 40, 60, 80, 30, 65, 20];
    let dups = fill(&mut nums, xs[..]);
    summarize("nums", &nums, dups, 65, 45);
    let mut words: Tree<Word> = Tree::new();
    let ws: [Word; 7] = [Word { text: "pear" }, Word { text: "fig" }, Word { text: "apple" }, Word { text: "kiwi" }, Word { text: "fig" }, Word { text: "banana" }, Word { text: "cherry" }];
    let wd = fill(&mut words, ws[..]);
    summarize("words", &words, wd, Word { text: "kiwi" }, Word { text: "grape" });
}
