pub enum Result<T, E> { Ok(T), Err(E) }

pub enum Option<T> { Some(T), None }

pub fn is_ok<T, E>(r: Result<T, E>) -> bool {
    match r {
        Ok(_) => true,
        Err(_) => false,
    }
}

pub fn is_err<T, E>(r: Result<T, E>) -> bool {
    match r {
        Ok(_) => false,
        Err(_) => true,
    }
}

pub fn is_some<T>(o: Option<T>) -> bool {
    match o {
        Some(_) => true,
        None => false,
    }
}

pub fn is_none<T>(o: Option<T>) -> bool {
    match o {
        Some(_) => false,
        None => true,
    }
}

pub fn unwrap_or<T, E>(r: Result<T, E>, d: T) -> T {
    match r {
        Ok(v) => v,
        Err(_) => d,
    }
}

pub fn err_or<T, E>(r: Result<T, E>, d: E) -> E {
    match r {
        Ok(_) => d,
        Err(e) => e,
    }
}

pub fn some_or<T>(o: Option<T>, d: T) -> T {
    match o {
        Some(v) => v,
        None => d,
    }
}

// a type parameter that appears only inside the returned enum is not inferred, so this surface fixes the error at i64
pub fn ok<T>(v: T) -> Result<T, i64> { Ok(v) }

pub fn err(e: i64) -> Result<i64, i64> { Err(e) }

pub fn ok_or<T>(o: Option<T>, e: i64) -> Result<T, i64> {
    match o {
        Some(v) => Ok(v),
        None => Err(e),
    }
}

pub fn err_code<T>(r: Result<T, i64>) -> i64 {
    match r {
        Ok(_) => 0,
        Err(e) => e,
    }
}

pub fn to_option<T, E>(r: Result<T, E>) -> Option<T> {
    match r {
        Ok(v) => Some(v),
        Err(_) => None,
    }
}

impl<T, E> Result<T, E> {
    pub fn is_ok(self) -> bool { is_ok(self) }
    pub fn is_err(self) -> bool { is_err(self) }
    pub fn unwrap_or(self, d: T) -> T { unwrap_or(self, d) }
    pub fn err_or(self, d: E) -> E { err_or(self, d) }
    pub fn ok(self) -> Option<T> { to_option(self) }
}

impl<T> Option<T> {
    pub fn is_some(self) -> bool { is_some(self) }
    pub fn is_none(self) -> bool { is_none(self) }
    pub fn unwrap_or(self, d: T) -> T { some_or(self, d) }
    pub fn ok_or(self, e: i64) -> Result<T, i64> { ok_or(self, e) }
}
