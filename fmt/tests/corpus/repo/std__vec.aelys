
use std::slice;
use std::sort;
use std::str;

pub fn len<T>(v: &Vec<T>) -> i64 { Vec::len(*v) }

pub fn is_empty<T>(v: &Vec<T>) -> bool { Vec::len(*v) == 0 }

pub fn get<T>(v: &Vec<T>, i: i64) -> Option<T> {
    if i < 0 { return None; }
    if i >= Vec::len(*v) { return None; }
    Some((*v)[i])
}

pub fn first<T>(v: &Vec<T>) -> Option<T> { get(v, 0) }

pub fn last<T>(v: &Vec<T>) -> Option<T> { get(v, Vec::len(*v) - 1) }

pub fn pop<T>(v: &mut Vec<T>) -> Option<T> { Vec::pop(*v) }

pub fn index_of<T: PartialEq>(v: &Vec<T>, x: T) -> i64 {
    for i in 0..Vec::len(*v) {
        if (*v)[i] == x { return i; }
    }
    -1
}

pub fn find<T: PartialEq>(v: &Vec<T>, x: T) -> Option<i64> {
    let i: i64 = index_of(v, x);
    if i < 0 { return None; }
    Some(i)
}

pub fn contains<T: PartialEq>(v: &Vec<T>, x: T) -> bool { index_of(v, x) >= 0 }

pub fn sum(v: &Vec<i64>) -> i64 { slice::sum(Vec::as_slice(*v)) }

pub fn eq<T: PartialEq>(a: &Vec<T>, b: &Vec<T>) -> bool { slice::eq(Vec::as_slice(*a), Vec::as_slice(*b)) }

pub fn is_sorted<T: Ord>(v: &Vec<T>) -> bool { slice::is_sorted(Vec::as_slice(*v)) }

pub fn binary_search<T: Ord>(v: &Vec<T>, x: T) -> i64 { sort::binary_search(Vec::as_slice(*v), x) }

pub fn from_slice<T>(s: &[T]) -> Vec<T> {
    let mut out = Vec::new();
    for x in s { Vec::push(out, x); }
    out
}

pub fn copy<T>(v: &Vec<T>) -> Vec<T> {
    let mut out = Vec::new();
    for x in Vec::as_slice(*v) { Vec::push(out, x); }
    out
}

pub fn concat<T>(a: &Vec<T>, b: &Vec<T>) -> Vec<T> {
    let mut out = Vec::new();
    for x in Vec::as_slice(*a) { Vec::push(out, x); }
    for y in Vec::as_slice(*b) { Vec::push(out, y); }
    out
}

pub fn reversed<T>(v: &Vec<T>) -> Vec<T> {
    let mut out = Vec::new();
    let mut i: i64 = Vec::len(*v) - 1;
    while i >= 0 {
        Vec::push(out, (*v)[i]);
        i = i - 1;
    }
    out
}

pub fn sorted<T: Ord>(v: &Vec<T>) -> Vec<T> {
    let out = copy(v);
    let m = Vec::try_as_unique_mut_slice(out);
    sort::insertion_sort(m);
    out
}

pub fn map<T, U>(v: &Vec<T>, f: fn(T) -> U) -> Vec<U> {
    let mut out = Vec::new();
    for x in Vec::as_slice(*v) {
        let y: U = f(x);
        Vec::push(out, y);
    }
    out
}

pub fn filter<T>(v: &Vec<T>, f: fn(T) -> bool) -> Vec<T> {
    let mut out = Vec::new();
    for x in Vec::as_slice(*v) {
        if f(x) { Vec::push(out, x); }
    }
    out
}

pub fn fold<T, A>(v: &Vec<T>, init: A, f: fn(A, T) -> A) -> A {
    let mut acc: A = init;
    for x in Vec::as_slice(*v) { acc = f(acc, x); }
    acc
}

pub fn sort_mut<T: Ord>(v: &mut Vec<T>) {
    let out = sorted(v);
    *v = out;
}

pub fn sort_by<T>(v: &mut Vec<T>, f: fn(T, T) -> i64) {
    let out = copy(v);
    let m = Vec::try_as_unique_mut_slice(out);
    sort::sort_by(m, f);
    *v = out;
}

pub fn join(v: &Vec<String>, sep: String) -> String { str::join(v, sep) }

impl<T> Vec<T> {
    pub fn is_empty(&self) -> bool { is_empty(self) }
    pub fn first(&self) -> Option<T> { first(self) }
    pub fn last(&self) -> Option<T> { last(self) }
    pub fn copy(&self) -> Vec<T> { copy(self) }
    pub fn concat(&self, other: &Vec<T>) -> Vec<T> { concat(self, other) }
    pub fn reversed(&self) -> Vec<T> { reversed(self) }
    pub fn map<U>(&self, f: fn(T) -> U) -> Vec<U> { map(self, f) }
    pub fn filter(&self, f: fn(T) -> bool) -> Vec<T> { filter(self, f) }
    pub fn fold<A>(&self, init: A, f: fn(A, T) -> A) -> A { fold(self, init, f) }
    pub fn sort_by(&mut self, f: fn(T, T) -> i64) { sort_by(self, f); }
}

impl<T: PartialEq> Vec<T> {
    pub fn index_of(&self, x: T) -> i64 { index_of(self, x) }
    pub fn find(&self, x: T) -> Option<i64> { find(self, x) }
    pub fn contains(&self, x: T) -> bool { contains(self, x) }
}

impl<T: Ord> Vec<T> {
    pub fn is_sorted(&self) -> bool { is_sorted(self) }
    pub fn binary_search(&self, x: T) -> i64 { binary_search(self, x) }
    pub fn sorted(&self) -> Vec<T> { sorted(self) }
    pub fn sort(&mut self) { sort_mut(self); }
}

impl Vec<i64> {
    pub fn sum(&self) -> i64 { sum(self) }
}

impl Vec<String> {
    pub fn join(&self, sep: String) -> String { join(self, sep) }
}
