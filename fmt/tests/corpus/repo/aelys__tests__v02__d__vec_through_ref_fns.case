fn ins(v: &mut Vec<i64>, x: i64) { Vec::insert(*v, 0, x); }
fn rem(v: &mut Vec<i64>) -> i64 { Vec::remove(*v, 0) }
fn peek(v: &Vec<i64>, i: i64) -> i64 {
    let mut r: i64 = -1;
    match Vec::get(*v, i) {
        Some(x) => { r = x; }
        None => { r = -1; }
    }
    r
}
fn main() {
    let mut v: Vec<i64> = vec![5];
    ins(&mut v, 4);
    ins(&mut v, 3);
    println!("{}", peek(&v, 1));
    println!("{}", peek(&v, 9));
    println!("{}", rem(&mut v));
    println!("{}", v.len());
}
