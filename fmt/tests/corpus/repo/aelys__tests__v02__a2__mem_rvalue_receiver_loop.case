struct N { s: String }

impl N {
    fn tag(&self, i: i64) -> String { format!("{}-{i}", self.s) }
    fn into_len(self) -> i64 { self.s.len() }
    fn rename(&mut self, i: i64) -> i64 {
        self.s = format!("n{i}");
        self.s.len()
    }
}

fn mk(i: i64) -> N { N { s: format!("x{i}") } }

fn main() {
    let mut t = 0;
    for i in 0..1000 {
        t = t + mk(i).tag(i).len() + mk(i).into_len() + mk(i).rename(i);
    }
    println!("{}", t);
}
