// Function with many parameters - tests register spilling / ABI
use std::process::ExitCode; fn sum8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    a + b + c + d + e + f + g + h
}

fn main() -> ExitCode {
    return ExitCode::from(sum8(1, 2, 3, 4, 5, 6, 7, 8) as u8);  // should be 36
}
