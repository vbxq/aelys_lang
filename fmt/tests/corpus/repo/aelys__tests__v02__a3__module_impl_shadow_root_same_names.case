mod tr; use tr::Show;
mod ma;

struct P { x: i64 }

impl Show for P {
    fn show(&self) -> i64 { self.x * 1000 }
}

impl PartialEq for P {
    fn eq(&self, o: &P) -> bool { self.x != o.x }
}

fn helper(x: i64) -> i64 { x + 100000 }

fn main() {
    println!("{}", ma::twice(ma::mk(2)));
    println!("{}", ma::gen(P { x: 3 }));
    println!("{}", ma::gen(ma::mk(3)));
    let r = P { x: 1 };
    println!("{}", r.shown());
    println!("{}", ma::same(ma::mk(4), ma::mk(4)));
    println!("{}", P { x: 4 } == P { x: 4 });
}
