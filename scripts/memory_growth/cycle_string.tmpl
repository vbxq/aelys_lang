struct N { s: string, next: Rc<N> }
fn churn(big: string, i: i64) -> i64 {
    let a: Rc<N> = Rc::new(N { s: big + "x", next: Rc::null() })
    a.next = a
    return Rc::get(a).s.len + i % 2
}
fn main() -> i64 {
    let mut big: string = "abcdefgh"
    let mut k = 0
    while k < 9 {
        big = big + big
        k = k + 1
    }
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < NN / 10 {
        n = n + churn(big, i)
        i = i + 1
    }
    println(n)
    return 0
}
