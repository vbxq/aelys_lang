struct In { s: String }
struct W { s: String, i: In }

fn victim(n: i64) -> String { "v" + format!("{n}") }

fn swap(h: Rc<W>, s: String, n: i64) -> i64 {
    h.s = victim(n);
    h.i.s = victim(n + 1);
    s.len() + s.as_bytes()[0]
}

fn main() {
    let a: Rc<W> = Rc::new(W { s: victim(0), i: In { s: victim(0) } });
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    while i < NN {
        Rc::get(a).s = victim(i);
        Rc::get(a).i.s = victim(i % 1000);
        n = n + swap(a, a.i.s, i % 1000);
        i = i + 1;
    }
    println!("{n} {} {}", a.s, a.i.s);
}
