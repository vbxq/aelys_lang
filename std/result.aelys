pub enum Result<T, E> { Ok(T), Err(E) }

pub enum Option<T> { Some(T), None }

pub fn is_ok<T, E>(r: Result<T, E>) -> bool {
    return match r {
        Ok(_) => true,
        Err(_) => false,
    }
}

pub fn is_err<T, E>(r: Result<T, E>) -> bool {
    return match r {
        Ok(_) => false,
        Err(_) => true,
    }
}

pub fn is_some<T>(o: Option<T>) -> bool {
    return match o {
        Some(_) => true,
        None => false,
    }
}

pub fn is_none<T>(o: Option<T>) -> bool {
    return match o {
        Some(_) => false,
        None => true,
    }
}

pub fn unwrap_or<T, E>(r: Result<T, E>, d: T) -> T {
    return match r {
        Ok(v) => v,
        Err(_) => d,
    }
}

pub fn err_or<T, E>(r: Result<T, E>, d: E) -> E {
    return match r {
        Ok(_) => d,
        Err(e) => e,
    }
}

pub fn some_or<T>(o: Option<T>, d: T) -> T {
    return match o {
        Some(v) => v,
        None => d,
    }
}

// a type parameter that appears only inside the returned enum is not inferred, so this surface fixes the error at i64
pub fn ok<T>(v: T) -> Result<T, i64> { return Ok(v) }

pub fn err(e: i64) -> Result<i64, i64> { return Err(e) }

pub fn ok_or<T>(o: Option<T>, e: i64) -> Result<T, i64> {
    return match o {
        Some(v) => Ok(v),
        None => Err(e),
    }
}

pub fn err_code<T>(r: Result<T, i64>) -> i64 {
    return match r {
        Ok(_) => 0,
        Err(e) => e,
    }
}
