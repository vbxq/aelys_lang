needs Option, Result from std.result

pub nogc fn is_empty(s: string) -> bool { return s.len == 0 }

// i is a byte offset here, the same index s.bytes takes and the same unit s.len counts
pub nogc fn is_char_boundary(s: string, i: i64) -> bool {
    if i < 0 { return false }
    if i > s.len { return false }
    if i == s.len { return true }
    let b: u8 = s.bytes[i]
    return (b & 192) != 128
}

pub nogc fn char_len(s: string, i: i64) -> i64 {
    if i < 0 { return -1 }
    if i >= s.len { return -1 }
    let b: u8 = s.bytes[i]
    if b < 128 { return 1 }
    if b < 192 { return -1 }
    if b < 224 { return 2 }
    if b < 240 { return 3 }
    if b < 248 { return 4 }
    return -1
}

pub nogc fn char_count(s: string) -> i64 {
    let mut n: i64 = 0
    for b in s.bytes {
        if (b & 192) != 128 { n = n + 1 }
    }
    return n
}

nogc fn byte_offset(s: string, k: i64) -> i64 {
    if k <= 0 { return 0 }
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i < s.len {
        i = i + 1
        while i < s.len and (s.bytes[i] & 192) == 128 { i = i + 1 }
        n = n + 1
        if n == k { return i }
    }
    return s.len
}

pub nogc fn char_at(s: string, i: i64) -> Option<char> {
    if i < 0 { return None }
    let mut k: i64 = 0
    for c in s {
        if k == i { return Some(c) }
        k = k + 1
    }
    return None
}

pub fn substring(s: string, start: i64, end: i64) -> string {
    let mut lo: i64 = start
    if lo < 0 { lo = 0 }
    let mut hi: i64 = end
    if hi < lo { hi = lo }
    return string::substring_bytes(s, byte_offset(s, lo), byte_offset(s, hi))
}

pub nogc fn compare(a: string, b: string) -> i64 {
    let mut n: i64 = a.len
    if b.len < n { n = b.len }
    let mut i: i64 = 0
    while i < n {
        let x: u8 = a.bytes[i]
        let y: u8 = b.bytes[i]
        if x != y {
            if x < y { return -1 }
            return 1
        }
        i = i + 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    return 0
}

pub nogc fn starts_with(s: string, p: string) -> bool {
    if p.len > s.len { return false }
    for i in 0..p.len {
        if s.bytes[i] != p.bytes[i] { return false }
    }
    return true
}

pub nogc fn ends_with(s: string, p: string) -> bool {
    if p.len > s.len { return false }
    let off: i64 = s.len - p.len
    for i in 0..p.len {
        if s.bytes[off + i] != p.bytes[i] { return false }
    }
    return true
}

// the answer is a character index, so the byte scan counts the characters it walks past
pub nogc fn index_of(s: string, needle: string) -> i64 {
    if needle.len == 0 { return 0 }
    if needle.len > s.len { return -1 }
    let last: i64 = s.len - needle.len
    let mut i: i64 = 0
    let mut n: i64 = 0
    while i <= last {
        if (s.bytes[i] & 192) != 128 {
            let mut j: i64 = 0
            let mut hit: bool = true
            while j < needle.len {
                if s.bytes[i + j] != needle.bytes[j] {
                    hit = false
                    break
                }
                j = j + 1
            }
            if hit { return n }
            n = n + 1
        }
        i = i + 1
    }
    return -1
}

pub nogc fn contains(s: string, needle: string) -> bool { return index_of(s, needle) >= 0 }

pub fn repeat(s: string, n: i64) -> string {
    let mut out: string = ""
    let mut i: i64 = 0
    while i < n {
        out = out + s
        i = i + 1
    }
    return out
}

pub nogc fn is_space(c: char) -> bool {
    return c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

nogc fn space_byte(b: u8) -> bool {
    return b == 32 or b == 9 or b == 10 or b == 13
}

pub fn trim(s: string) -> string {
    let mut lo: i64 = 0
    while lo < s.len and space_byte(s.bytes[lo]) { lo = lo + 1 }
    let mut hi: i64 = s.len
    while hi > lo and space_byte(s.bytes[hi - 1]) { hi = hi - 1 }
    return string::substring_bytes(s, lo, hi)
}

// an empty separator would never advance, so the whole string comes back as one part
pub fn split(s: string, sep: string) -> Vec<string> {
    let mut out = Vec::new()
    if sep.len == 0 {
        Vec::push(out, s)
        return out
    }
    let mut start: i64 = 0
    let mut i: i64 = 0
    let last: i64 = s.len - sep.len
    // utf-8 is self synchronising, so a byte run equal to sep can only begin on a character boundary
    while i <= last {
        let mut j: i64 = 0
        let mut hit: bool = true
        while j < sep.len {
            if s.bytes[i + j] != sep.bytes[j] {
                hit = false
                break
            }
            j = j + 1
        }
        if hit {
            let part: string = string::substring_bytes(s, start, i)
            Vec::push(out, part)
            i = i + sep.len
            start = i
        } else {
            i = i + 1
        }
    }
    let tail: string = string::substring_bytes(s, start, s.len)
    Vec::push(out, tail)
    return out
}

pub fn join(parts: &Vec<string>, sep: string) -> string {
    let mut out: string = ""
    let mut lead: bool = true
    for p in Vec::as_slice(*parts) {
        if lead { lead = false } else { out = out + sep }
        out = out + p
    }
    return out
}

nogc fn digit_of(b: u8) -> i64 {
    if b < 48 { return -1 }
    if b > 57 { return -1 }
    return (b as i64) - 48
}

// err codes: 1 empty, 2 sign with no digits, 3 non-digit, 4 out of i64 range
pub nogc fn parse_int(s: string) -> Result<i64, i64> {
    if s.len == 0 { return Err(1) }
    let mut i: i64 = 0
    let mut neg: bool = false
    if s.bytes[0] == 45 {
        neg = true
        i = 1
    }
    if i >= s.len { return Err(2) }
    // the least i64 is unspellable as a literal
    let min: i64 = 0 - 9223372036854775807 - 1
    let limit: i64 = min / 10
    let mut acc: i64 = 0
    // + and * wrap silently, so the magnitude accumulates negative and every step is checked before it runs
    while i < s.len {
        let d: i64 = digit_of(s.bytes[i])
        if d < 0 { return Err(3) }
        if acc < limit { return Err(4) }
        acc = acc * 10
        if acc < min + d { return Err(4) }
        acc = acc - d
        i = i + 1
    }
    if neg { return Ok(acc) }
    if acc == min { return Err(4) }
    let v: i64 = 0 - acc
    return Ok(v)
}

pub fn from_int(n: i64) -> string { return "{n}" }

pub nogc fn find(s: string, needle: string) -> Option<i64> {
    let i: i64 = index_of(s, needle)
    if i < 0 { return None }
    return Some(i)
}

pub fn chars(s: string) -> Vec<char> {
    let mut out = Vec::new()
    for c in s { Vec::push(out, c) }
    return out
}

nogc fn line_end(s: string, start: i64, end: i64) -> i64 {
    if end > start and s.bytes[end - 1] == 13 { return end - 1 }
    return end
}

pub fn lines(s: string) -> Vec<string> {
    let mut out = Vec::new()
    let mut start: i64 = 0
    let mut i: i64 = 0
    while i < s.len {
        if s.bytes[i] == 10 {
            let part: string = string::substring_bytes(s, start, line_end(s, start, i))
            Vec::push(out, part)
            start = i + 1
        }
        i = i + 1
    }
    if start < s.len {
        let tail: string = string::substring_bytes(s, start, line_end(s, start, s.len))
        Vec::push(out, tail)
    }
    return out
}

pub fn replace(s: string, old: string, new: string) -> string {
    if old.len == 0 { return s }
    let mut out: string = ""
    let mut start: i64 = 0
    let mut i: i64 = 0
    let last: i64 = s.len - old.len
    while i <= last {
        let mut j: i64 = 0
        let mut hit: bool = true
        while j < old.len {
            if s.bytes[i + j] != old.bytes[j] {
                hit = false
                break
            }
            j = j + 1
        }
        if hit {
            out = out + string::substring_bytes(s, start, i) + new
            i = i + old.len
            start = i
        } else {
            i = i + 1
        }
    }
    out = out + string::substring_bytes(s, start, s.len)
    return out
}

fn shift_case(c: char, lo: char, hi: char, delta: i64) -> char {
    if c >= lo and c <= hi { return char::from_i64((c as i64) + delta) }
    return c
}

pub fn to_upper(s: string) -> string {
    let mut out: string = ""
    for c in s { out = out + string::from_char(shift_case(c, 'a', 'z', -32)) }
    return out
}

pub fn to_lower(s: string) -> string {
    let mut out: string = ""
    for c in s { out = out + string::from_char(shift_case(c, 'A', 'Z', 32)) }
    return out
}

pub fn pad_left(s: string, w: i64) -> string {
    let n: i64 = char_count(s)
    if n >= w { return s }
    return repeat(" ", w - n) + s
}

pub fn pad_right(s: string, w: i64) -> string {
    let n: i64 = char_count(s)
    if n >= w { return s }
    return s + repeat(" ", w - n)
}

pub fn split_whitespace(s: string) -> Vec<string> {
    let mut out = Vec::new()
    let mut i: i64 = 0
    while i < s.len {
        while i < s.len and space_byte(s.bytes[i]) { i = i + 1 }
        let start: i64 = i
        while i < s.len and !space_byte(s.bytes[i]) { i = i + 1 }
        if i > start {
            let part: string = string::substring_bytes(s, start, i)
            Vec::push(out, part)
        }
    }
    return out
}

pub nogc fn is_digit(c: char) -> bool { return c >= '0' and c <= '9' }

pub nogc fn is_alpha(c: char) -> bool { return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') }

pub nogc fn to_digit(c: char) -> Option<i64> {
    if is_digit(c) { return Some((c as i64) - 48) }
    return None
}

impl str {
    pub nogc fn char_count(self) -> i64 { return char_count(self) }
    pub nogc fn is_empty(self) -> bool { return is_empty(self) }
    pub nogc fn is_char_boundary(self, i: i64) -> bool { return is_char_boundary(self, i) }
    pub nogc fn char_len(self, i: i64) -> i64 { return char_len(self, i) }
    pub nogc fn char_at(self, i: i64) -> Option<char> { return char_at(self, i) }
    pub fn substring(self, start: i64, end: i64) -> string { return substring(self, start, end) }
    pub nogc fn compare(self, other: string) -> i64 { return compare(self, other) }
    pub nogc fn starts_with(self, p: string) -> bool { return starts_with(self, p) }
    pub nogc fn ends_with(self, p: string) -> bool { return ends_with(self, p) }
    pub nogc fn index_of(self, needle: string) -> i64 { return index_of(self, needle) }
    pub nogc fn contains(self, needle: string) -> bool { return contains(self, needle) }
    pub nogc fn find(self, needle: string) -> Option<i64> { return find(self, needle) }
    pub fn repeat(self, n: i64) -> string { return repeat(self, n) }
    pub fn trim(self) -> string { return trim(self) }
    pub fn split(self, sep: string) -> Vec<string> { return split(self, sep) }
    pub nogc fn parse_int(self) -> Result<i64, i64> { return parse_int(self) }
    pub fn chars(self) -> Vec<char> { return chars(self) }
    pub fn lines(self) -> Vec<string> { return lines(self) }
    pub fn replace(self, old: string, new: string) -> string { return replace(self, old, new) }
    pub fn to_upper(self) -> string { return to_upper(self) }
    pub fn to_lower(self) -> string { return to_lower(self) }
    pub fn pad_left(self, w: i64) -> string { return pad_left(self, w) }
    pub fn pad_right(self, w: i64) -> string { return pad_right(self, w) }
    pub fn split_whitespace(self) -> Vec<string> { return split_whitespace(self) }
}

impl char {
    pub nogc fn is_space(self) -> bool { return is_space(self) }
    pub nogc fn is_digit(self) -> bool { return is_digit(self) }
    pub nogc fn is_alpha(self) -> bool { return is_alpha(self) }
    pub nogc fn to_digit(self) -> Option<i64> { return to_digit(self) }
}
