pub nogc fn insertion_sort(s: &mut [i64]) {
    let mut i: i64 = 1
    while i < s.len {
        let x: i64 = s[i]
        let mut j: i64 = i - 1
        while j >= 0 and s[j] > x {
            s[j + 1] = s[j]
            j = j - 1
        }
        s[j + 1] = x
        i = i + 1
    }
}

pub nogc fn binary_search(s: &[i64], x: i64) -> i64 {
    let mut lo: i64 = 0
    let mut hi: i64 = s.len - 1
    while lo <= hi {
        let mid: i64 = lo + (hi - lo) / 2
        if s[mid] == x { return mid }
        if s[mid] < x { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}
