pub nogc fn abs(x: i64) -> i64 {
    if x < 0 { return -x } else { return x }
}

pub nogc fn min(a: i64, b: i64) -> i64 {
    if a < b { return a } else { return b }
}

pub nogc fn max(a: i64, b: i64) -> i64 {
    if a > b { return a } else { return b }
}

pub nogc fn clamp(x: i64, lo: i64, hi: i64) -> i64 {
    return min(max(x, lo), hi)
}

pub nogc fn sign(x: i64) -> i64 {
    if x > 0 { return 1 }
    if x < 0 { return -1 }
    return 0
}

// a negative exponent answers the truncated rational b^e, which is zero unless the base is a unit
pub nogc fn pow(b: i64, e: i64) -> i64 {
    if e < 0 {
        if b == 1 { return 1 }
        if b == -1 {
            if e % 2 == 0 { return 1 } else { return -1 }
        }
        return 0
    }
    let mut acc: i64 = 1
    let mut sq: i64 = b
    let mut n: i64 = e
    while n > 0 {
        if n % 2 == 1 { acc = acc * sq }
        sq = sq * sq
        n = n / 2
    }
    return acc
}

// abs wraps at the least i64, so a gcd of two such values is that value and not a magnitude
pub nogc fn gcd(a: i64, b: i64) -> i64 {
    let mut x: i64 = abs(a)
    let mut y: i64 = abs(b)
    while y != 0 {
        let t: i64 = x % y
        x = y
        y = t
    }
    return x
}

pub nogc fn lcm(a: i64, b: i64) -> i64 {
    let g: i64 = gcd(a, b)
    if g == 0 { return 0 }
    return abs(a / g * b)
}

pub nogc fn abs_f(x: f64) -> f64 {
    if x < 0.0 { return -x } else { return x }
}

pub nogc fn min_f(a: f64, b: f64) -> f64 {
    if a < b { return a } else { return b }
}

pub nogc fn max_f(a: f64, b: f64) -> f64 {
    if a > b { return a } else { return b }
}
