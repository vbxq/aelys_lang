needs std.result
needs std.slice
needs std.sort

pub fn len(v: &Vec<i64>) -> i64 { return Vec::len(*v) }

pub fn is_empty(v: &Vec<i64>) -> bool { return Vec::len(*v) == 0 }

pub fn get(v: &Vec<i64>, i: i64) -> result.Option<i64> {
    if i < 0 { return result.Option::None }
    if i >= Vec::len(*v) { return result.Option::None }
    let x: i64 = (*v)[i]
    return result.Option::Some(x)
}

pub fn first(v: &Vec<i64>) -> result.Option<i64> { return get(v, 0) }

pub fn last(v: &Vec<i64>) -> result.Option<i64> { return get(v, Vec::len(*v) - 1) }

pub fn index_of(v: &Vec<i64>, x: i64) -> i64 {
    for i in 0..Vec::len(*v) {
        if (*v)[i] == x { return i }
    }
    return -1
}

pub fn contains(v: &Vec<i64>, x: i64) -> bool { return index_of(v, x) >= 0 }

pub fn sum(v: &Vec<i64>) -> i64 {
    let mut acc: i64 = 0
    for i in 0..Vec::len(*v) { acc = acc + (*v)[i] }
    return acc
}

pub fn eq(a: &Vec<i64>, b: &Vec<i64>) -> bool {
    if Vec::len(*a) != Vec::len(*b) { return false }
    for i in 0..Vec::len(*a) {
        if (*a)[i] != (*b)[i] { return false }
    }
    return true
}

pub fn is_sorted(v: &Vec<i64>) -> bool { return slice.is_sorted(Vec::as_slice(*v)) }

pub fn binary_search(v: &Vec<i64>, x: i64) -> i64 { return sort.binary_search(Vec::as_slice(*v), x) }

pub fn from_slice(s: &[i64]) -> Vec<i64> {
    let mut out = Vec::new()
    for i in 0..s.len {
        // pushing `s[i]` straight in is E0714: a reference may not be stored into a container
        let x: i64 = s[i]
        Vec::push(out, x)
    }
    return out
}

pub fn copy(v: &Vec<i64>) -> Vec<i64> {
    let mut out = Vec::new()
    for i in 0..Vec::len(*v) {
        let x: i64 = (*v)[i]
        Vec::push(out, x)
    }
    return out
}

pub fn concat(a: &Vec<i64>, b: &Vec<i64>) -> Vec<i64> {
    let mut out = Vec::new()
    for i in 0..Vec::len(*a) {
        let x: i64 = (*a)[i]
        Vec::push(out, x)
    }
    for i in 0..Vec::len(*b) {
        let y: i64 = (*b)[i]
        Vec::push(out, y)
    }
    return out
}

pub fn reversed(v: &Vec<i64>) -> Vec<i64> {
    let mut out = Vec::new()
    let mut i: i64 = Vec::len(*v) - 1
    while i >= 0 {
        let x: i64 = (*v)[i]
        Vec::push(out, x)
        i = i - 1
    }
    return out
}

pub fn sorted(v: &Vec<i64>) -> Vec<i64> {
    let out = copy(v)
    let m = Vec::try_as_unique_mut_slice(out)
    sort.insertion_sort(m)
    return out
}

pub fn map(v: &Vec<i64>, f: fn(i64) -> i64) -> Vec<i64> {
    let mut out = Vec::new()
    for i in 0..Vec::len(*v) {
        let y: i64 = f((*v)[i])
        Vec::push(out, y)
    }
    return out
}

pub fn filter(v: &Vec<i64>, f: fn(i64) -> bool) -> Vec<i64> {
    let mut out = Vec::new()
    for i in 0..Vec::len(*v) {
        let x: i64 = (*v)[i]
        if f(x) { Vec::push(out, x) }
    }
    return out
}

pub fn fold(v: &Vec<i64>, init: i64, f: fn(i64, i64) -> i64) -> i64 {
    let mut acc: i64 = init
    for i in 0..Vec::len(*v) { acc = f(acc, (*v)[i]) }
    return acc
}
