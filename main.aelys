fn main() -> i64 {
    let s1 = "hello"
    let s2 = "hello"
    let s3 = "world"

    if s1 == s2 {
        println("s1 == s2: true")
    } else {
        println("s1 == s2: false")
        return 1
    }

    if s1 != s3 {
        println("s1 != s3: true")
    } else {
        println("s1 != s3: false")
        return 2
    }

    return 0
}
