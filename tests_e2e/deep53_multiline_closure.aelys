fn compose(f: fn(i64) -> i64, g: fn(i64) -> i64) -> fn(i64) -> i64 {
    return fn(x: i64) -> i64 {
        let fx = f(x)
        return g(fx)
    }
}

fn add1(x: i64) -> i64 { return x + 1 }
fn mul2(x: i64) -> i64 { return x * 2 }

fn main() -> i64 {
    // compose(add1, mul2)(5) = mul2(add1(5)) = mul2(6) = 12
    let add_then_double = compose(add1, mul2)
    let r = add_then_double(5)
    if r == 12 {
        return 1
    }
    return 0
}
