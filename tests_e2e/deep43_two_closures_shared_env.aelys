fn make_pair() -> fn() -> i64 {
    let mut n = 0
    let inc = fn() -> i64 {
        n = n + 1
        return n
    }
    let dec = fn() -> i64 {
        n = n - 1
        return n
    }
    // call dec once, inc twice, should see n=1
    dec()
    inc()
    return inc
}

fn main() -> i64 {
    let f = make_pair()
    let r = f()
    if r == 2 {
        return 1
    }
    return 0
}
