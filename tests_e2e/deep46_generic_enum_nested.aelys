enum MyResult<T> {
    Ok(T),
    Err(bool),
}

fn safe_div(a: i64, b: i64) -> MyResult<i64> {
    if b == 0 {
        return MyResult::Err(true)
    }
    return MyResult::Ok(a / b)
}

fn main() -> i64 {
    let r1 = safe_div(10, 2)
    let r2 = safe_div(10, 0)
    let v1 = match r1 {
        MyResult::Ok(n) => n,
        MyResult::Err(_) => -1,
    }
    let v2 = match r2 {
        MyResult::Ok(n) => n,
        MyResult::Err(_) => -1,
    }
    if v1 == 5 && v2 == -1 {
        return 1
    }
    return 0
}
