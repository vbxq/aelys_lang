enum State {
    Running(i64),
    Done,
}

fn main() -> i64 {
    let mut s = State::Running(0)
    let mut count = 0
    while count < 5 {
        s = match s {
            State::Running(n) => State::Running(n + 1),
            State::Done => State::Done,
        }
        count = count + 1
    }
    match s {
        State::Running(n) => return n,
        State::Done => return -1,
    }
}
