enum Color {
    Red,
    Green,
    Blue,
}

enum Option<T> {
    Some(T),
    None,
}

fn main() {
    let colors: [Color; 3] = [Color::Red, Color::Green, Color::Blue]
    let mut i = 0
    while i < 3 {
        match colors[i] {
            Color::Red => println(1)
            Color::Green => println(2)
            Color::Blue => println(3)
        }
        i = i + 1
    }

    let opts: [Option<i64>; 3] = [Option::Some(1), Option::None, Option::Some(3)]
    i = 0
    while i < 3 {
        match opts[i] {
            Option::Some(v) => println(v)
            Option::None => println(0)
        }
        i = i + 1
    }
}
