fn sum_stepped(n: i64) -> i64 {
    let mut sum = 0
    // 'n' in '0..n' and 'step n' all refer to the param n
    for i in 0..10 step n {
        sum = sum + i
    }
    return sum
}

fn main() -> i64 {
    // sum_stepped(2): 0, 2, 4, 6, 8 = 20
    let r = sum_stepped(2)
    if r == 20 {
        return 1
    }
    return 0
}
