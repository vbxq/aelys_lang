fn find_first(arr: [i64; 5], target: i64) -> i64 {
    let mut i = 0
    while i < 5 {
        if arr[i] == target {
            return i
        }
        i = i + 1
    }
    return -1
}

fn main() -> i64 {
    let arr = [10, 20, 30, 40, 50]
    let idx = find_first(arr, 30)
    if idx == 2 {
        return 1
    }
    return 0
}
