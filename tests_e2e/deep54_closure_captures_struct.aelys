struct Config {
    base: i64,
    scale: i64,
}

fn make_transformer(cfg: Config) -> fn(i64) -> i64 {
    return fn(x: i64) -> i64 {
        return cfg.base + cfg.scale * x
    }
}

fn main() -> i64 {
    let cfg = Config { base: 10, scale: 3 }
    let transform = make_transformer(cfg)
    let r = transform(5)
    // 10 + 3*5 = 25
    if r == 25 {
        return 1
    }
    return 0
}
