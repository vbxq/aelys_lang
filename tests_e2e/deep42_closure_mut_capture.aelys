fn make_counter() -> fn() -> i64 {
    let mut n = 0
    let inc = fn() -> i64 {
        n = n + 1
        return n
    }
    return inc
}

fn main() -> i64 {
    let c = make_counter()
    let a = c()
    let b = c()
    let d = c()
    if a == 1 && b == 2 && d == 3 {
        return 1
    }
    return 0
}
