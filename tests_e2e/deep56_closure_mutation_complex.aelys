fn make_accumulator() -> fn(i64) -> i64 {
    let mut total = 0
    return fn(x: i64) -> i64 {
        total = total + x
        return total
    }
}

fn main() -> i64 {
    let acc = make_accumulator()
    acc(1)
    acc(2)
    acc(3)
    let r = acc(4)
    // total = 1+2+3+4 = 10
    if r == 10 {
        return 1
    }
    return 0
}
