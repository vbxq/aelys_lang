fn apply_to_arr(arr: [i64; 3], f: fn(i64) -> i64) -> [i64; 3] {
    let mut res = [0, 0, 0]
    res[0] = f(arr[0])
    res[1] = f(arr[1])
    res[2] = f(arr[2])
    return res
}

fn double(x: i64) -> i64 { return x * 2 }

fn main() -> i64 {
    let arr = [1, 2, 3]
    let doubled = apply_to_arr(arr, double)
    if doubled[0] == 2 && doubled[1] == 4 && doubled[2] == 6 {
        return 1
    }
    return 0
}
