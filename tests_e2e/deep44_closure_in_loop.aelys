fn main() -> i64 {
    let mut sum = 0
    let adder = fn(x: i64) -> i64 {
        sum = sum + x
        return sum
    }
    // adder captures sum by value (=0). Each call updates adder's env.sum.
    // After 5 calls: 0+0=0, 0+1=1, 1+2=3, 3+3=6, 6+4=10
    adder(0)
    adder(1)
    adder(2)
    adder(3)
    let result = adder(4)
    if result == 10 {
        return 1
    }
    return 0
}
